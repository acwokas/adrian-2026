# Canonical site URL. Defaults to the preview URL when unset.
# Set to https://adrianwatkins.com only at cutover.
SITE_URL=https://adrianwatkins-com-preview.pages.dev

# Google Tag Manager container ID (e.g. GTM-XXXXXXX).
# Leave blank locally to skip injection. Pattern mirrors the aiin* sites.
GTM_ID=
