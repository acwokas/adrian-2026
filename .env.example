# Canonical site URL. Defaults to the preview URL when unset.
# Set to https://adrianwatkins.com only at cutover.
SITE_URL=https://adrianwatkins-com-preview.pages.dev

# Google Tag Manager container ID (e.g. GTM-XXXXXXX).
# Leave blank locally to skip injection. Pattern mirrors the aiin* sites.
GTM_ID=

# Resend API key for the /contact form (Cloudflare Pages Function at /api/contact).
# Bind as a Pages secret in production. When unset, the function logs to console
# and returns success so the form still works in the UI for demo purposes.
RESEND_API_KEY=

# Optional Resend sender / recipient overrides for the contact form.
# Defaults: from=website@adrianwatkins.com, to=me@adrianwatkins.com.
CONTACT_FROM=
CONTACT_TO=

# Calendly (or Cal.com) URL for the /contact booking embed. Until set, the page
# shows a "booking widget arrives shortly" notice with a mailto fallback.
# When provided, swap into the iframe src in src/pages/contact.astro.
CALENDLY_URL=
