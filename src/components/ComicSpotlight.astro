---
import { Image } from 'astro:assets';
import type { PublishedComic } from '../data/comics';

interface Props { comic: PublishedComic; id?: string; }
const { comic, id = 'latest-comic' } = Astro.props;
---

<section class="comic-spotlight" id={id} aria-labelledby={`${id}-heading`}>
  <div class="comic-grid">
    <a class="comic-art" href={`/writing/comics#${comic.frameId}`} aria-label={`View the comic: ${comic.title}`}>
      <Image src={comic.image} alt={comic.alt} widths={[360, 600, 900]} sizes="(max-width: 760px) 100vw, 360px" format="webp" quality={85} loading="lazy" decoding="async" />
    </a>
    <div class="comic-copy">
      <div class="eyebrow">The latest Friday Frame comic</div>
      <h2 id={`${id}-heading`}>A Friday Frame, in pictures.</h2>
      <p class="comic-date"><time datetime={comic.date.toISOString()}>{comic.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Singapore' })}</time></p>
      <h3>{comic.title}</h3>
      <p>{comic.summary}</p>
      <p>A visual take on the ideas behind my weekly reflection. Explore the comic, then read the full piece.</p>
      <div class="ctarow">
        <a class="btn btn-primary" href={comic.href}>Read this Friday Frame</a>
        <a class="btn btn-secondary" href="/writing/comics">Browse the comics</a>
      </div>
    </div>
  </div>
</section>

<style>
  .comic-spotlight { padding: 48px 0; border-top: 1px solid var(--rule); scroll-margin-top: 90px; }
  .comic-grid { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.4fr); gap: 48px; align-items: center; }
  .comic-art { display: block; max-width: 360px; }
  .comic-art img { display: block; width: 100%; height: auto; border-radius: 4px; }
  .comic-art:focus-visible { outline: 3px solid var(--accent); outline-offset: 6px; }
  h2 { margin: 12px 0 18px; font-size: clamp(30px, 4vw, 44px); }
  h3 { margin-bottom: 16px; }
  .comic-date { color: var(--muted); font-size: 13px; margin-bottom: 12px; }
  @media (max-width: 760px) { .comic-grid { grid-template-columns: 1fr; gap: 28px; } .comic-art { max-width: 100%; } }
</style>
