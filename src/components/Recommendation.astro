---
interface Props { quote: string; name: string; relationship: string; date: string; datetime: string; }
const { quote, name, relationship, date, datetime } = Astro.props;
---
<figure class="recommendation">
  <blockquote><p>{quote}</p></blockquote>
  <figcaption><strong>{name}</strong><span>{relationship} · <time datetime={datetime}>{date}</time></span><a href="https://www.linkedin.com/in/adrianwatkins/details/recommendations/" target="_blank" rel="noopener noreferrer" aria-label={`Read ${name}’s recommendation on LinkedIn, opens in a new tab`}>Read on LinkedIn ↗</a></figcaption>
</figure>
<style>
.recommendation { margin: 0; border-top: 2px solid #D89A55; padding: 26px 0 0; display: flex; flex-direction: column; }
blockquote { margin: 0 0 24px; padding: 0; border: 0; font-family: Georgia, serif; font-size: 21px; line-height: 1.55; }
blockquote p { margin: 0; }
figcaption { margin-top: auto; font-size: 14px; line-height: 1.6; }
figcaption strong, figcaption span { display: block; }
figcaption span { color: var(--ink-soft); }
figcaption a { display: inline-block; margin-top: 12px; }
</style>
