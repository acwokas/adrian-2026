---
/**
 * ShareButtons: end-of-article share strip.
 *
 * Renders four controls inline: X (Twitter), LinkedIn, Copy link, Email.
 * Restrained styling that matches Adrian's existing aesthetic (muted, no
 * emoji, no exclamation copy). Uses inline Lucide-style SVG so we do not
 * pull a runtime icon dep.
 *
 * Both the LinkedIn and X buttons now prefill the composer with a
 * sensible caption built from the post frontmatter. LinkedIn's
 * sharing/share-offsite endpoint stopped honouring summary text years
 * ago, so we use feed/?shareActive=true&text=... which still prefills
 * the composer for logged-in users. X uses intent/tweet with the
 * dedicated hashtags param so the tags render as proper tags.
 *
 * Props:
 *   title:   article title (used as caption headline and email subject)
 *   url:     canonical absolute URL of the article
 *   excerpt: one-sentence summary used in the caption (optional)
 *   tags:    topic tags from frontmatter, converted to hashtags
 *   section: "Friday Frame" for FF entries, else the section name
 */
interface Props {
  title: string;
  url: string;
  excerpt?: string;
  tags?: string[];
  section?: string;
}

const {
  title,
  url,
  excerpt = '',
  tags = [],
  section = '',
} = Astro.props;

const isFridayFrame = section === 'Friday Frame';

// Convert a topic tag like "ai search" or "AI literacy" into a hashtag
// like "AISearch" or "AILiteracy". Whitespace, hyphens, and underscores
// split the tag into segments. Two-letter all-lowercase segments are
// treated as acronyms and uppercased (so "ai" becomes "AI"). Everything
// else gets its first letter capitalised while internal case is
// preserved, which keeps tags like "AI literacy" looking right.
function toHashtag(tag: string): string {
  const segments = tag.split(/[\s\-_]+/).filter(Boolean);
  const camel = segments
    .map((seg) => seg.replace(/[^A-Za-z0-9]/g, ''))
    .filter(Boolean)
    .map((seg) => {
      if (/^[a-z]{1,2}$/.test(seg)) return seg.toUpperCase();
      return seg.charAt(0).toUpperCase() + seg.slice(1);
    })
    .join('');
  return camel ? `#${camel}` : '';
}

// Always include #AdrianWatkins. Friday Frame posts also always include
// #FridayFrame. Topic tags from frontmatter come after, deduplicated,
// and the full list is capped at five so the composer stays readable.
const HASHTAG_CAP = 5;
const fixedHashtags: string[] = isFridayFrame
  ? ['#FridayFrame', '#AdrianWatkins']
  : ['#AdrianWatkins'];

const topicHashtags = tags
  .map(toHashtag)
  .filter(Boolean)
  .filter((h) => !fixedHashtags.includes(h));

const allHashtags = [...fixedHashtags, ...topicHashtags].slice(0, HASHTAG_CAP);
const hashtagLine = allHashtags.join(' ');

// Build the multi-line caption used for the LinkedIn composer. The
// Friday Frame variant adds a single positioning line so a brand-new
// LinkedIn reader sees what the series is without leaving the post.
const captionExcerpt = (excerpt || '').trim();

const captionLines = isFridayFrame
  ? [
      `"${title}"`,
      '',
      captionExcerpt,
      '',
      'Friday Frame is my weekly 200-word piece on how AI is reshaping work.',
      '',
      hashtagLine,
      '',
      url,
    ]
  : [
      `"${title}"`,
      '',
      captionExcerpt,
      '',
      hashtagLine,
      '',
      url,
    ];

// Collapse adjacent blank lines that appear when an optional segment
// (like an empty excerpt) drops out, so the composer does not show
// runs of empty lines.
const caption = captionLines
  .filter((line, idx, arr) => line !== '' || (idx > 0 && arr[idx - 1] !== ''))
  .join('\n');

// LinkedIn: /feed/?shareActive=true&text=... is the surviving prefill
// surface (sharing/share-offsite stopped accepting summary years ago).
// When the user is logged in this opens the composer prefilled with
// our caption; when they are not, LinkedIn shows the login wall then
// drops them into the prefilled composer after auth.
const liHref = `https://www.linkedin.com/feed/?shareActive=true&text=${encodeURIComponent(caption)}`;

// X: keep the text short so the prefilled tweet stays under 280 chars
// across long titles. Hashtags go through the dedicated param so X
// renders them as tags rather than appending raw "#foo" text.
const xText = `"${title}"`;
const xHashtagParam = allHashtags.map((h) => h.replace(/^#/, '')).join(',');
const xHref = `https://twitter.com/intent/tweet?text=${encodeURIComponent(xText)}&url=${encodeURIComponent(url)}${
  xHashtagParam ? `&hashtags=${encodeURIComponent(xHashtagParam)}` : ''
}`;

const mailHref = `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(`${title}\n\n${url}\n\n(via adrianwatkins.com)`)}`;
---

<div class="share" data-share-url={url} data-share-title={title} aria-label="Share this post">
  <span class="share-label">Share:</span>

  <a
    class="share-btn"
    href={xHref}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Share on X (Twitter)"
    title="Share on X (Twitter)"
  >
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 4h4.5l4 5.8L17.5 4H20l-6.5 8.6L20 20h-4.5l-4.4-6.3L6 20H3.5l7-9.1Z"/>
    </svg>
    <span class="share-btn-label">X</span>
  </a>

  <a
    class="share-btn"
    href={liHref}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Share on LinkedIn"
    title="Share on LinkedIn"
  >
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/>
      <rect x="2" y="9" width="4" height="12"/>
      <circle cx="4" cy="4" r="2"/>
    </svg>
    <span class="share-btn-label">LinkedIn</span>
  </a>

  <button
    class="share-btn share-copy"
    type="button"
    aria-label="Copy link to this post"
    title="Copy link"
    data-share-copy
  >
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M10 13a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
      <path d="M14 11a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07L12.7 19.4"/>
    </svg>
    <span class="share-btn-label" data-share-copy-label>Copy link</span>
  </button>

  <a
    class="share-btn"
    href={mailHref}
    aria-label="Share via email"
    title="Share via email"
  >
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="5" width="18" height="14" rx="1"/>
      <path d="M3 7l9 6 9-6"/>
    </svg>
    <span class="share-btn-label">Email</span>
  </a>
</div>

<script is:inline>
  (function () {
    if (window.__shareButtonsBound) return;
    window.__shareButtonsBound = true;

    document.addEventListener('click', async (event) => {
      const btn = event.target.closest('[data-share-copy]');
      if (!btn) return;
      event.preventDefault();
      const container = btn.closest('.share');
      const url = (container && container.getAttribute('data-share-url')) || location.href;
      const labelEl = btn.querySelector('[data-share-copy-label]');
      const originalLabel = labelEl ? labelEl.textContent : 'Copy link';
      try {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          await navigator.clipboard.writeText(url);
        } else {
          const tmp = document.createElement('textarea');
          tmp.value = url;
          tmp.setAttribute('readonly', '');
          tmp.style.position = 'absolute';
          tmp.style.left = '-9999px';
          document.body.appendChild(tmp);
          tmp.select();
          document.execCommand('copy');
          document.body.removeChild(tmp);
        }
        if (labelEl) labelEl.textContent = 'Copied';
        btn.setAttribute('data-copied', 'true');
      } catch (_err) {
        if (labelEl) labelEl.textContent = 'Press Ctrl+C';
      }
      setTimeout(() => {
        if (labelEl) labelEl.textContent = originalLabel || 'Copy link';
        btn.removeAttribute('data-copied');
      }, 2400);
    });
  })();
</script>

<style>
  .share {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 12px;
    margin: 56px 0 24px 0;
    padding: 14px 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    font-family: 'Inter', system-ui, sans-serif;
  }
  .share-label {
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 600;
    margin-right: 4px;
  }
  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    line-height: 1;
    font-weight: 500;
    color: var(--ink-soft);
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: 2px;
    padding: 7px 11px;
    text-decoration: none;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }
  .share-btn svg { display: block; }
  .share-btn:hover {
    color: #1A1714;
    border-color: #D89A55;
    background: #FBF7EF;
  }
  .share-btn[data-copied="true"] {
    color: #1F4A30;
    border-color: #1F4A30;
    background: #F2F6F1;
  }
  .share-btn-label { letter-spacing: 0.02em; }

  @media (max-width: 520px) {
    .share { gap: 6px 8px; }
    .share-btn { padding: 6px 9px; font-size: 12.5px; }
    .share-btn-label { display: inline; }
  }
</style>
