---
// Source checked in the original Vulcan Post article on 13 November 2026.
const featureUrl = 'https://vulcanpost.com/914334/mycareersfuture-job-offers-salary-bands/';
---
<section class="press-feature" id="payline-vulcan-post" aria-label="PayLine in the press">
  <div class="container press-grid">
    <div class="press-brand">
      <span class="eyebrow">As featured in</span>
      <img src="/images/vulcan-post-logo.svg" alt="Vulcan Post" width="200" height="38" loading="lazy" decoding="async" />
    </div>
    <div>
      <div class="eyebrow">Singapore · 11 November 2026 · Editor’s Pick</div>
      <h2>PayLine in Vulcan Post’s Editor’s Picks.</h2>
      <p>Vulcan Post featured PayLine’s approach to exploring Singapore’s advertised salary bands.</p>
      <div class="ctarow">
        <a class="btn btn-primary" href={featureUrl} target="_blank" rel="noopener noreferrer">Read the feature <span aria-hidden="true">↗</span></a>
        <a class="btn btn-secondary" href="https://payline.sg" target="_blank" rel="noopener noreferrer">Explore PayLine <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </div>
</section>
<style>
  .press-feature { padding: 56px 0; border-top: 1px solid var(--line); scroll-margin-top: 100px; }
  .press-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 40px; align-items: center; }
  .press-brand { min-height: 200px; padding: 32px; border: 1px solid var(--line); border-radius: 8px; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 24px; }
  .press-brand img { display: block; width: 100%; max-width: 280px; height: auto; }
  h2 { margin: 12px 0 20px; }
  p { margin: 0 0 16px; }
  @media (max-width: 760px) { .press-grid { grid-template-columns: 1fr; gap: 24px; } }
</style>
