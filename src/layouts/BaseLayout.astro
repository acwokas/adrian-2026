---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AnalyticsHead from '../components/AnalyticsHead.astro';
import AnalyticsBody from '../components/AnalyticsBody.astro';
import { personSchema, websiteSchema } from '../data/person';

interface Props {
  title: string;
  description: string;
  current?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  articleSection?: string;
  articleTags?: string[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  // When true, suppresses the default Person + WebSite schema (rare;
  // only use if a page is intentionally not about Adrian).
  skipDefaultSchema?: boolean;
  canonicalOverride?: string;
}

const {
  title,
  description,
  current = '',
  ogImage = '/og/site-default.png',
  ogImageAlt = 'Adrian Watkins. Operator. Builder. Governor.',
  ogType = 'website',
  publishedTime,
  modifiedTime,
  author = 'Adrian Watkins',
  articleSection,
  articleTags = [],
  jsonLd,
  skipDefaultSchema = false,
  canonicalOverride,
} = Astro.props;

// Production canonical host. Override at build time with SITE_URL only if you
// genuinely want a non-apex canonical (e.g. local dev). Production deploys MUST
// resolve to https://adrianwatkins.com so LinkedIn / X preview crawlers see a
// canonical that matches the shared URL.
const PROD_SITE = 'https://adrianwatkins.com';
const siteUrl = import.meta.env.SITE_URL || Astro.site?.toString() || PROD_SITE;
const cleanSite = siteUrl.replace(/\/$/, '');
const cleanPath = (Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/');
const canonical = canonicalOverride || `${cleanSite}${cleanPath}`;
const ogImageAbs = ogImage.startsWith('http') ? ogImage : `${cleanSite}${ogImage}`;

// Build the full JSON-LD payload for this page.
//
// Strategy: every page emits a baseline Person + WebSite schema (single
// source of truth in src/data/person.ts). Pages that need additional
// schema (ProfilePage on /about, Article on Friday Frame posts, etc.)
// pass it via the `jsonLd` prop and we concatenate.
//
// The Person + WebSite blocks use stable @id values so multiple schema
// blocks on the same page reference the same entity rather than each
// declaring a fresh Person.
const defaultSchema = skipDefaultSchema ? [] : [personSchema, websiteSchema];
const extraSchema = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const schemaBlocks = [...defaultSchema, ...extraSchema];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:secure_url" content={ogImageAbs} />
    <meta property="og:image:type" content={ogImageAbs.endsWith('.jpg') || ogImageAbs.endsWith('.jpeg') ? 'image/jpeg' : 'image/png'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content="Adrian Watkins" />

    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    {ogType === 'article' && author && (
      <meta property="article:author" content={author} />
    )}
    {ogType === 'article' && articleSection && (
      <meta property="article:section" content={articleSection} />
    )}
    {ogType === 'article' && articleTags.length > 0 && articleTags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap"
    />

    <link rel="alternate" hreflang="en-GB" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <meta http-equiv="content-language" content="en-GB" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {schemaBlocks.map((block) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}

    <meta name="author" content="Adrian Watkins" />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1" />

    <AnalyticsHead />
  </head>
  <body>
    <AnalyticsBody />
    <Nav current={current} />
    <main id="top">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      // Defensive: ensure mailto: anchors always navigate to the OS mail handler
      // even if a downstream listener (GTM tag, future script, etc.) calls preventDefault.
      document.addEventListener('click', (e) => {
        const a = e.target.closest('a[href^="mailto:"]');
        if (!a) return;
        if (e.defaultPrevented) {
          e.stopImmediatePropagation();
          window.location.href = a.href;
        }
      }, true);
    </script>
  </body>
</html>
