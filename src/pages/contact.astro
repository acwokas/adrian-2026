---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PERSON_ID } from '../data/person';

const title = 'Contact Adrian Watkins. Singapore.';
const description = 'Connect with Singapore-based Adrian Watkins about executive leadership, non-executive director and advisory opportunities, pro bono mentoring and student programmes.';

const contactJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Adrian Watkins',
  url: 'https://adrianwatkins.com/contact',
  description,
  mainEntity: { '@id': PERSON_ID },
};
---

<BaseLayout title={title} description={description} current="contact" jsonLd={contactJsonLd}>
  <section class="stub" style="padding-bottom:48px">
    <div class="container">
      <div class="eyebrow">Contact</div>
      <h1>Let's talk.</h1>
      <p class="lede">I welcome thoughtful conversations about leading and growing technology businesses, building useful services, and helping organisations move forward with clarity.</p>

      <div class="prose" style="margin-top:24px">
        <p>That includes executive leadership, non-executive director and advisory conversations where my commercial, operating and governance experience could be useful.</p>
        <p>Singapore is home. My perspective and experience span regional and global markets, with an appreciation for the local context that makes each business different.</p>
      </div>

      <div class="ctarow" style="margin-top:32px;margin-bottom:8px">
        <a class="btn btn-primary" href="mailto:me@adrianwatkins.com">Email me@adrianwatkins.com</a>
        <a class="btn btn-secondary" href="https://www.linkedin.com/in/adrianwatkins/" target="_blank" rel="noopener noreferrer" style="display:inline-flex;align-items:center;gap:8px">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43c-1.14 0-2.06-.93-2.06-2.06s.92-2.07 2.06-2.07 2.06.93 2.06 2.07c0 1.13-.92 2.06-2.06 2.06zm1.78 13.02H3.56V9h3.56v11.45z"/></svg>
          LinkedIn
        </a>
      </div>
      <p class="quiet" style="font-size:13px">I typically respond within two business days.</p>
    </div>
  </section>

  <section class="alt" style="padding:64px 0">
    <div class="container">
      <h2 style="margin-bottom:14px">Find a time to talk.</h2>
      <p class="prose" style="margin-bottom:28px">Choose a suitable time below, or <a href="mailto:me@adrianwatkins.com">email me</a> to arrange a conversation.</p>

      <div
        class="calendly-inline-widget"
        data-url="https://calendly.com/adrian-watkins1/new-meeting"
        style="min-width:0;width:100%;height:720px;border:1px solid var(--rule);background:#fff;border-radius:2px;overflow:hidden"
      ></div>
      <script type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async is:inline></script>
      <p class="quiet" style="font-size:13px;margin-top:12px">If the embed does not load, the direct link is <a href="https://calendly.com/adrian-watkins1/new-meeting" target="_blank" rel="noopener noreferrer">calendly.com/adrian-watkins1/new-meeting</a>.</p>
    </div>
  </section>

  <section style="padding:64px 0">
    <div class="container">
      <h2 style="margin-bottom:14px">Send a note.</h2>
      <p class="prose" style="margin-bottom:28px">Share a little about yourself and what you have in mind.</p>

      <form id="contact-form" class="contact-form">
        <div class="field">
          <label for="cf-name">Name</label>
          <input id="cf-name" name="name" type="text" autocomplete="name" required maxlength="200" />
        </div>
        <div class="field">
          <label for="cf-email">Email</label>
          <input id="cf-email" name="email" type="email" autocomplete="email" required maxlength="320" />
        </div>
        <div class="field">
          <label for="cf-message">Message</label>
          <textarea id="cf-message" name="message" required rows="6" maxlength="8000"></textarea>
        </div>
        <div class="field hp" aria-hidden="true">
          <label for="cf-hp">Leave this field empty</label>
          <input id="cf-hp" name="honeypot" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <div class="field actions">
          <button type="submit" class="btn btn-primary" id="cf-submit">Send</button>
          <span id="cf-status" class="cf-status" role="status" aria-live="polite"></span>
        </div>
      </form>
      <p class="quiet" style="font-size:13px;margin-top:16px">Your details are used to respond to your enquiry. <a href="/privacy">Read the privacy notice</a>.</p>
    </div>
  </section>

  <section class="alt" style="padding:64px 0">
    <div class="container">
      <h2 style="margin-bottom:24px">Contributing in Singapore</h2>
      <div class="prose">
        <p><a href="/singapore">Singapore</a> is home, and giving back here matters to me. I welcome opportunities to support students and emerging founders through pro bono mentoring, guest teaching and practical conversations about business, technology and turning ideas into action.</p>
        <p>If you are organising a student programme or community initiative, tell me about the people involved and what you hope they will take away. I consider opportunities around the audience, scope and where I can make a useful contribution.</p>
        <p>For industry speaking, moderation and executive roundtables, please visit my <a href="/speaking">speaking page</a> or <a href="mailto:me@adrianwatkins.com">reach out directly</a>.</p>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .contact-form { max-width: 620px; display: grid; gap: 18px; }
  .contact-form .field { display: flex; flex-direction: column; gap: 8px; }
  .contact-form label {
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 600;
  }
  .contact-form input,
  .contact-form textarea {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink);
    background: #fff;
    border: 1px solid var(--rule-strong);
    border-radius: 2px;
    padding: 12px 14px;
    width: 100%;
    transition: border-color .15s ease;
  }
  .contact-form input:focus,
  .contact-form textarea:focus {
    outline: none;
    border-color: var(--accent);
  }
  .contact-form textarea { resize: vertical; min-height: 140px; }
  .contact-form .hp {
    position: absolute;
    left: -9999px;
    top: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .contact-form .actions {
    flex-direction: row;
    align-items: center;
    gap: 18px;
  }
  .cf-status { font-size: 14px; color: var(--muted); }
  .cf-status.ok { color: #2D6A4F; }
  .cf-status.err { color: var(--accent); }
</style>

<script is:inline>
  (function () {
    const form = document.getElementById('contact-form');
    if (!form) return;
    const status = document.getElementById('cf-status');
    const submit = document.getElementById('cf-submit');

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      status.className = 'cf-status';
      status.textContent = 'Sending...';
      submit.disabled = true;

      const data = {
        name: form.elements['name'].value.trim(),
        email: form.elements['email'].value.trim(),
        message: form.elements['message'].value.trim(),
        honeypot: form.elements['honeypot'].value,
      };

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        const body = await res.json().catch(function () { return {}; });
        if (res.ok && body.ok) {
          status.className = 'cf-status ok';
          status.textContent = 'Sent. Thank you for getting in touch.';
          form.reset();
        } else {
          status.className = 'cf-status err';
          const errors = { missing_fields: 'Please complete your name, email and message.', invalid_fields: 'Please check your details and try again.', invalid_email: 'Please enter a valid email address.' };
          status.textContent = errors[body.error] || 'Your message could not be sent. Please email me@adrianwatkins.com directly.';
        }
      } catch (err) {
        status.className = 'cf-status err';
        status.textContent = 'Network error. Please email me directly.';
      } finally {
        submit.disabled = false;
      }
    });
  })();
</script>
