---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FridayFramePromo from '../../components/FridayFramePromo.astro';
import NotifySignup from '../../components/NotifySignup.astro';
import { getCollection } from 'astro:content';
import crossPostData from '../../data/cross-posts.json';

const title = 'Writing. Adrian Watkins.';
const description = 'Long-form executive writing and the Friday Frame. Operators, governance, applied intelligence. Asia-Pacific.';

const writingPosts = await getCollection('writing', ({ data }) => !data.draft);
const framePosts = await getCollection('fridayFrame', ({ data, id }) => !data.draft && id !== 'welcome');

// Merge both collections into one chronological feed. Distinguish kind so the
// list can render an "FF" badge on Friday Frame entries.
type Entry = {
  kind: 'writing' | 'frame';
  id: string;
  title: string;
  date: Date;
  summary: string;
  tags: string[];
  canonical?: string;
};
const merged: Entry[] = [
  ...writingPosts.map((p): Entry => ({
    kind: 'writing',
    id: p.id,
    title: p.data.title,
    date: p.data.date,
    summary: p.data.summary,
    tags: p.data.tags,
    canonical: p.data.canonical,
  })),
  ...framePosts.map((p): Entry => ({
    kind: 'frame',
    id: p.id,
    title: p.data.title,
    date: p.data.date,
    summary: p.data.summary,
    tags: [],
  })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf());

const entryHref = (e: Entry) =>
  e.kind === 'frame' ? `/writing/friday-frame/${e.id}` : `/writing/${e.id}`;

type CrossPostEntry = {
  slug: string;
  title: string;
  excerpt: string;
  published_at: string;
  source: string;
  site_name: string;
  canonical_url: string;
};

const crossPosts = (crossPostData.entries as CrossPostEntry[])
  .slice()
  .sort((a, b) => b.published_at.localeCompare(a.published_at));

const siteBadge = (site: string) => {
  const tone: Record<string, string> = {
    'AI in Asia': '#0F2E4D',
    'AI in Arabia': '#5C3617',
    'AI in Europe': '#1F4A30',
  };
  return tone[site] || '#1A1714';
};

const writingJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Writing. Adrian Watkins.',
  url: 'https://adrianwatkins.com/writing',
  description,
  author: { '@type': 'Person', name: 'Adrian Watkins', url: 'https://adrianwatkins.com' },
  blogPost: merged.map((e) => ({
    '@type': 'BlogPosting',
    headline: e.title,
    url: e.canonical || `https://adrianwatkins.com${entryHref(e)}`,
    datePublished: e.date.toISOString(),
    description: e.summary,
  })),
};
---

<BaseLayout title={title} description={description} current="writing" jsonLd={writingJsonLd}>
  <section class="stub">
    <div class="container">
      <div class="eyebrow">Writing</div>
      <h1>Frames, essays, and cross-posts.</h1>
      <p class="lede">Long-form writing, with cross-links to <a href="https://aiinasia.com" target="_blank" rel="noopener noreferrer">AIinASIA</a> where appropriate. The canonical executive writing lives here. Two regular threads: the <a href="/writing/friday-frame">Friday Frame</a> (weekly, 200 words) and the <a href="/now#reading">Reading list</a> (quarterly).</p>

      <FridayFramePromo variant="hero" />

      {merged.length === 0 ? (
        <div class="prose" style="margin-top:48px">
          <p><strong>First essays publishing soon.</strong></p>
          <p class="stub-note" style="margin-top:24px">RSS feed: <a href="/writing/rss.xml">/writing/rss.xml</a>.</p>
        </div>
      ) : (
        <ul class="writing-list" style="margin-top:8px;list-style:none;padding:0">
          {merged.map((e) => (
            <li style="border-top:1px solid var(--rule);padding:24px 0">
              <article>
                <div class="eyebrow" style="margin-bottom:8px;font-size:11px">
                  {e.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
                  {e.kind === 'frame' && (
                    <span class="ff-tag">FF</span>
                  )}
                  {e.tags.length > 0 && (
                    <span style="color:var(--muted);margin-left:12px;font-weight:400">{e.tags.join(' / ')}</span>
                  )}
                </div>
                <h2 style="font-size:28px;margin-bottom:10px">
                  <a href={entryHref(e)} style="text-decoration:none">{e.title}</a>
                </h2>
                <p style="font-family:'Fraunces',serif;font-size:18px;line-height:1.55;color:var(--ink-soft);max-width:680px;margin:0">{e.summary}</p>
              </article>
            </li>
          ))}
        </ul>
      )}

      <h2 style="margin-top:96px;margin-bottom:8px;font-size:32px">Cross-posted essays.</h2>
      <p class="aside" style="color:var(--muted);margin-bottom:32px">Bylined work first published on the <a href="https://aiinasia.com" target="_blank" rel="noopener noreferrer">AIinASIA</a> / AIinArabia / AIinEurope mastheads. Canonical lives at the source.</p>
      <ul class="writing-list" style="list-style:none;padding:0">
        {crossPosts.map((p) => (
          <li style="border-top:1px solid var(--rule);padding:24px 0">
            <article>
              <div class="eyebrow" style="margin-bottom:8px;font-size:11px">
                {new Date(p.published_at).toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
                <span style={`display:inline-block;margin-left:12px;font-weight:700;font-size:11px;color:#FFFFFF;background-color:${siteBadge(p.site_name)};padding:3px 10px;border-radius:3px;letter-spacing:0.06em;text-transform:uppercase`}>{p.site_name}</span>
              </div>
              <h3 style="font-size:24px;margin-bottom:10px">
                <a href={p.canonical_url} target="_blank" rel="noopener noreferrer" style="text-decoration:none">{p.title}</a>
              </h3>
              <p style="font-family:'Fraunces',serif;font-size:17px;line-height:1.55;color:var(--ink-soft);max-width:680px;margin:0">{p.excerpt}</p>
            </article>
          </li>
        ))}
      </ul>

      <NotifySignup variant="card" source="/writing" />
    </div>
  </section>
</BaseLayout>

<style>
  .ff-tag {
    display: inline-block;
    margin-left: 10px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #1A1714;
    background: #D89A55;
    padding: 2px 7px;
    border-radius: 2px;
    text-transform: uppercase;
  }
</style>
