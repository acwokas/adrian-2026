---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FridayFramePromo from '../../components/FridayFramePromo.astro';
import NotifySignup from '../../components/NotifySignup.astro';
import { getCollection } from 'astro:content';
import crossPostData from '../../data/cross-posts.json';
import { PERSON_ID } from '../../data/person';
import ComicSpotlight from '../../components/ComicSpotlight.astro';
import { getPublishedComics } from '../../data/comics';

const latestComic = (await getPublishedComics())[0];

const title = 'Writing by Adrian Watkins. Essays, Friday Frame and selected articles.';
const description = 'Essays, Friday Frame reflections, comics and selected articles by Adrian Watkins on technology, work, data and everyday life in Singapore and beyond.';

const writingPosts = await getCollection('writing', ({ data }) => !data.draft);
const framePosts = await getCollection('fridayFrame', ({ data, id }) => !data.draft && id !== 'welcome');

// Merge both collections into one chronological feed. Distinguish kind so the
// list can render an "FF" badge on Friday Frame entries.
type Entry = {
  kind: 'writing' | 'frame';
  id: string;
  title: string;
  date: Date;
  updatedDate?: Date;
  summary: string;
  tags: string[];
  canonical?: string;
};
const merged: Entry[] = [
  ...writingPosts.map((p): Entry => ({
    kind: 'writing',
    id: p.id,
    title: p.data.title,
    date: p.data.date,
    updatedDate: p.data.updatedDate,
    summary: p.data.summary,
    tags: p.data.tags,
    canonical: p.data.canonical,
  })),
  ...framePosts.map((p): Entry => ({
    kind: 'frame',
    id: p.id,
    title: p.data.title,
    date: p.data.date,
    summary: p.data.summary,
    tags: [],
  })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf());

const entryHref = (e: Entry) =>
  e.kind === 'frame' ? `/writing/friday-frame/${e.id}` : `/writing/${e.id}`;

type CrossPostEntry = {
  slug: string;
  title: string;
  excerpt: string;
  published_at: string;
  source: string;
  site_name: string;
  canonical_url: string;
  topic: string;
  author: string;
};

const crossPosts = (crossPostData.entries as CrossPostEntry[])
  .slice()
  .sort((a, b) => b.published_at.localeCompare(a.published_at));

const writingJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Writing. Adrian Watkins.',
  url: 'https://adrianwatkins.com/writing',
  description,
  author: { '@id': PERSON_ID },
  blogPost: merged.map((e) => ({
    '@type': 'BlogPosting',
    headline: e.title,
    url: e.canonical || `https://adrianwatkins.com${entryHref(e)}`,
    datePublished: e.date.toISOString(),
    ...(e.updatedDate ? { dateModified: e.updatedDate.toISOString() } : {}),
    description: e.summary,
  })),
};
const selectedWritingJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': 'https://adrianwatkins.com/writing#selected-writing',
  name: 'Selected writing across my publications',
  itemListElement: crossPosts.map((p, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Article',
      headline: p.title,
      url: p.canonical_url,
      datePublished: p.published_at,
      description: p.excerpt,
      author: { '@id': PERSON_ID },
      publisher: { '@type': 'Organization', name: p.site_name, url: new URL(p.canonical_url).origin },
    },
  })),
};

---

<BaseLayout title={title} description={description} current="writing" jsonLd={[writingJsonLd, selectedWritingJsonLd]}>
  <section class="stub">
    <div class="container">
      <header class="writing-intro">
      <div class="eyebrow">Writing</div>
      <h1>Ideas, observations and practical perspectives.</h1>
      <p class="lede">I write about leading and growing businesses, the changing role of technology, and the decisions that turn ideas into useful outcomes.</p>
      <div class="prose" style="margin-top:24px">
        <p>My perspective comes from commercial and operating leadership, building services of my own, and staying curious about how people and organisations work. I explore what emerging ideas and developments mean for businesses and communities across Asia and globally, and how their implications change with the market, culture and context.</p>
        <p>Here you will find longer essays alongside the <a href="/writing/friday-frame">Friday Frame</a>, my weekly reflection on something that caught my attention and what it might mean in practice. For the books, conversations and interests shaping my thinking, visit my <a href="/now">now page</a>.</p>
        <p>All views are my own.</p>
      </div>

      </header>

      <nav class="writing-formats" aria-label="Browse writing">
        <a href="#selected-writing">Across my publications</a>
        <a href="#articles">Essays and Friday Frame</a>
        <a href="/writing/comics">Friday Frame comics →</a>
      </nav>

      <div class="writing-features">
      {latestComic && <ComicSpotlight comic={latestComic} id="writing-comic" />}

      <aside aria-labelledby="book-heading" style="border:1px solid var(--rule-strong);padding:28px;margin:36px 0;max-width:760px">
        <p class="eyebrow">A book in progress</p>
        <h2 id="book-heading" style="font-size:32px;margin:12px 0">Heir Presumptive</h2>
        <p style="font-family:'Manrope','Inter',sans-serif;font-size:21px">Who Gets the Final Say When Our Creations Become Creators</p>
        <p>A non-fiction book exploring artificial intelligence, succession and who inherits power, with Asia at the centre.</p>
        <a href="/writing/heir-presumptive">Read the prologue extract →</a>
      </aside>

      </div>

      <section id="selected-writing" class="estate-writing" aria-labelledby="selected-writing-heading">
        <div class="section-head">
          <div>
            <p class="eyebrow">A wider reading list</p>
            <h2 id="selected-writing-heading">Across my publications.</h2>
          </div>
          <p class="aside">Selected writing on technology, work, data and everyday life. Each piece was published under my byline and links to its original home.</p>
        </div>
        <ul class="estate-writing-list">
          {crossPosts.map((p) => (
            <li>
              <article class="estate-article">
                <p class="estate-topic">{p.topic}</p>
                <div class="estate-meta">
                  <span>{p.site_name}</span>
                  <time datetime={p.published_at}>{new Date(p.published_at).toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Singapore' })}</time>
                </div>
                <h3><a href={p.canonical_url} target="_blank" rel="noopener noreferrer">{p.title}</a></h3>
                <p class="estate-excerpt">{p.excerpt}</p>
                <a class="estate-read" href={p.canonical_url} target="_blank" rel="noopener noreferrer">Read on {p.site_name}<span aria-hidden="true"> ↗</span><span class="sr-only"> (opens in a new tab)</span></a>
              </article>
            </li>
          ))}
        </ul>
      </section>

      <FridayFramePromo variant="hero" />

      {merged.length === 0 ? (
        <div class="prose" style="margin-top:48px">
          <p><strong>First essays publishing soon.</strong></p>
          <p class="stub-note" style="margin-top:24px">RSS feed: <a href="/writing/rss.xml">/writing/rss.xml</a>.</p>
        </div>
      ) : (
        <ul id="articles" class="writing-list" style="margin-top:8px;list-style:none;padding:0;scroll-margin-top:100px">
          {merged.map((e) => (
            <li style="border-top:1px solid var(--rule);padding:24px 0">
              <article>
                <div class="eyebrow" style="margin-bottom:8px;font-size:11px">
                  {e.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
                  {e.kind === 'frame' && (
                    <span class="ff-tag">FF</span>
                  )}
                  {e.tags.length > 0 && (
                    <span style="color:var(--muted);margin-left:12px;font-weight:400">{e.tags.join(' / ')}</span>
                  )}
                </div>
                <h2 style="font-size:28px;margin-bottom:10px">
                  <a href={entryHref(e)} style="text-decoration:none">{e.title}</a>
                </h2>
                <p style="font-family:'Manrope',sans-serif;font-size:18px;line-height:1.55;color:var(--ink-soft);max-width:680px;margin:0">{e.summary}</p>
              </article>
            </li>
          ))}
        </ul>
      )}

      <NotifySignup variant="card" source="/writing" />
    </div>
  </section>
</BaseLayout>

<style>
  .writing-formats { display: flex; flex-wrap: wrap; gap: 16px 28px; margin: 28px 0; font-size: 15px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  :global(body[data-site-design='writing']) .estate-writing { padding: 28px 0 56px; scroll-margin-top: 110px; }
  .estate-writing .section-head { gap: 32px; }
  .estate-writing .section-head .aside { max-width: 470px; margin: 0; }
  .estate-writing-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 48px; list-style: none; padding: 0; margin: 0; }
  .estate-writing-list > li { min-width: 0; border-top: 1px solid var(--rule-strong); padding: 28px 0 32px; }
  .estate-topic { margin: 0 0 12px; color: var(--accent); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; font-weight: 650; }
  .estate-meta { display: flex; flex-wrap: wrap; gap: 6px 16px; align-items: baseline; font-size: 12px; line-height: 1.7; color: var(--muted); margin-bottom: 14px; }
  .estate-meta > span { color: var(--ink); font-weight: 650; }
  .estate-article h3 { font-size: clamp(24px, 2.4vw, 29px); margin-bottom: 16px; }
  .estate-article h3 a { text-decoration: none; }
  .estate-article h3 a:hover { text-decoration: underline; }
  .estate-excerpt { font-size: 15px; line-height: 1.8; margin: 0 0 18px; }
  .estate-read { font-size: 13px; font-weight: 600; }
  @media (max-width: 760px) {
    .estate-writing .section-head { display: block; }
    .estate-writing .section-head .aside { margin-top: 20px; }
    .estate-writing-list { grid-template-columns: 1fr; }
  }
  .ff-tag {
    display: inline-block;
    margin-left: 10px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #121B28;
    background: #214FE6;
    padding: 2px 7px;
    border-radius: 2px;
    text-transform: uppercase;
  }
</style>
