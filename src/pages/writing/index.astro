---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import crossPostData from '../../data/cross-posts.json';

const title = 'Writing. Adrian Watkins.';
const description = 'Long-form executive writing and the Friday Note. Operators, governance, applied intelligence. Asia-Pacific.';

const allPosts = await getCollection('writing', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

type CrossPostEntry = {
  slug: string;
  title: string;
  excerpt: string;
  published_at: string;
  source: string;
  site_name: string;
  canonical_url: string;
};

const crossPosts = (crossPostData.entries as CrossPostEntry[])
  .slice()
  .sort((a, b) => b.published_at.localeCompare(a.published_at));

const siteBadge = (site: string) => {
  // Saturated pill backgrounds with white text. Each meets WCAG AA on white text.
  const tone: Record<string, string> = {
    'AI in Asia': '#0F2E4D',
    'AI in Arabia': '#5C3617',
    'AI in Europe': '#1F4A30',
  };
  return tone[site] || '#1A1714';
};

const writingJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Writing. Adrian Watkins.',
  url: 'https://adrianwatkins.com/writing',
  description,
  author: { '@type': 'Person', name: 'Adrian Watkins', url: 'https://adrianwatkins.com' },
  blogPost: posts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    url: post.data.canonical || `https://adrianwatkins.com/writing/${post.id}`,
    datePublished: post.data.date.toISOString(),
    description: post.data.summary,
  })),
};
---

<BaseLayout title={title} description={description} current="writing" jsonLd={writingJsonLd}>
  <section class="stub">
    <div class="container">
      <div class="eyebrow">Writing</div>
      <h1>Notes, essays, and the Friday Note.</h1>
      <p class="lede">Long-form writing, with cross-links to AiinASIA where appropriate. The canonical executive writing lives here. Two regular threads: the <a href="/writing/friday-note">Friday Note</a> (weekly, 200 words) and the <a href="/now#reading">Reading list</a> (quarterly).</p>

      {posts.length === 0 ? (
        <div class="prose" style="margin-top:48px">
          <p><strong>First essays publishing soon.</strong></p>
          <p class="stub-note" style="margin-top:24px">RSS feed: <a href="/writing/rss.xml">/writing/rss.xml</a>.</p>
        </div>
      ) : (
        <ul class="writing-list" style="margin-top:48px;list-style:none;padding:0">
          {posts.map((post) => (
            <li style="border-top:1px solid var(--rule);padding:24px 0">
              <article>
                <div class="eyebrow" style="margin-bottom:8px;font-size:11px">
                  {post.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
                  {post.data.tags.length > 0 && (
                    <span style="color:var(--muted);margin-left:12px;font-weight:400">{post.data.tags.join(' / ')}</span>
                  )}
                </div>
                <h2 style="font-size:28px;margin-bottom:10px">
                  <a href={`/writing/${post.id}`} style="text-decoration:none">{post.data.title}</a>
                </h2>
                <p style="font-family:'Fraunces',serif;font-size:18px;line-height:1.55;color:var(--ink-soft);max-width:680px;margin:0">{post.data.summary}</p>
              </article>
            </li>
          ))}
        </ul>
      )}

      <h2 style="margin-top:96px;margin-bottom:8px;font-size:32px">Cross-posted essays.</h2>
      <p class="aside" style="color:var(--muted);margin-bottom:32px">Bylined work first published on the AiinASIA / AiinArabia / AiinEurope mastheads. Canonical lives at the source.</p>
      <ul class="writing-list" style="list-style:none;padding:0">
        {crossPosts.map((p) => (
          <li style="border-top:1px solid var(--rule);padding:24px 0">
            <article>
              <div class="eyebrow" style="margin-bottom:8px;font-size:11px">
                {new Date(p.published_at).toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
                <span style={`display:inline-block;margin-left:12px;font-weight:700;font-size:11px;color:#FFFFFF;background-color:${siteBadge(p.site_name)};padding:3px 10px;border-radius:3px;letter-spacing:0.06em;text-transform:uppercase`}>{p.site_name}</span>
              </div>
              <h3 style="font-size:24px;margin-bottom:10px">
                <a href={p.canonical_url} target="_blank" rel="noopener noreferrer" style="text-decoration:none">{p.title}</a>
              </h3>
              <p style="font-family:'Fraunces',serif;font-size:17px;line-height:1.55;color:var(--ink-soft);max-width:680px;margin:0">{p.excerpt}</p>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
