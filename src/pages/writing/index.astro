---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const title = 'Writing. Adrian Watkins.';
const description = 'Long-form executive writing and the Friday Note. Operators, governance, applied intelligence. Asia-Pacific.';

const allPosts = await getCollection('writing', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title={title} description={description} current="writing">
  <section class="stub">
    <div class="container">
      <div class="eyebrow">Writing</div>
      <h1>Notes, essays, and the Friday Note.</h1>
      <p class="lede">Long-form writing, with cross-links to AiinASIA where appropriate. The canonical executive writing lives here. Two regular threads: the <a href="/writing/friday-note">Friday Note</a> (weekly, 200 words) and the <a href="/now#reading">Reading list</a> (quarterly).</p>

      {posts.length === 0 ? (
        <div class="prose" style="margin-top:48px">
          <p><strong>First essays publishing soon.</strong></p>
          <p class="stub-note" style="margin-top:24px">RSS feed: <a href="/writing/rss.xml">/writing/rss.xml</a>.</p>
        </div>
      ) : (
        <ul class="writing-list" style="margin-top:48px;list-style:none;padding:0">
          {posts.map((post) => (
            <li style="border-top:1px solid var(--rule);padding:24px 0">
              <article>
                <div class="eyebrow" style="margin-bottom:8px;font-size:11px">
                  {post.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
                  {post.data.tags.length > 0 && (
                    <span style="color:var(--muted);margin-left:12px;font-weight:400">{post.data.tags.join(' / ')}</span>
                  )}
                </div>
                <h2 style="font-size:28px;margin-bottom:10px">
                  <a href={`/writing/${post.id}`} style="text-decoration:none">{post.data.title}</a>
                </h2>
                <p style="font-family:'Fraunces',serif;font-size:18px;line-height:1.55;color:var(--ink-soft);max-width:680px;margin:0">{post.data.summary}</p>
              </article>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</BaseLayout>
