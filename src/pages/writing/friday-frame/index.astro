---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { PERSON_ID } from '../../../data/person';

const title = 'Friday Frame by Adrian Watkins. Weekly 200-500 word notes on applied intelligence.';
const description = 'Friday Frame by Adrian Watkins. A 200-500 word weekly note on applied intelligence, governance, and commercial leadership across Asia-Pacific. One thing noticed, every Friday.';

const allNotes = await getCollection('fridayFrame', ({ data }) => !data.draft);
const notes = allNotes.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fridayFrameJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Friday Frame. Adrian Watkins.',
  url: 'https://adrianwatkins.com/writing/friday-frame',
  description,
  author: { '@id': PERSON_ID },
};
---

<BaseLayout
  title={title}
  description={description}
  current="writing"
  ogImage="/og/friday-frame-default.png"
  ogImageAlt="Friday Frame. Adrian Watkins."
  jsonLd={fridayFrameJsonLd}
>
  <section class="stub">
    <div class="container">
      <div class="eyebrow">Writing / Friday Frame</div>
      <h1>The Friday Frame archive.</h1>
      <p class="lede">A 200-500 word weekly frame on applied intelligence, governance, and commercial leadership across Asia-Pacific. One thing noticed, every Friday. Archive below, newest first.</p>

      {notes.length === 0 ? (
        <div class="prose" style="margin-top:48px">
          <p><strong>First frame publishing this Friday.</strong></p>
          <p class="stub-note" style="margin-top:24px">RSS feed: <a href="/writing/rss.xml">/writing/rss.xml</a>.</p>
        </div>
      ) : (
        <ul class="writing-list" style="margin-top:48px;list-style:none;padding:0">
          {notes.map((note) => (
            <li style="border-top:1px solid var(--rule);padding:24px 0">
              <article>
                <div class="eyebrow" style="margin-bottom:8px;font-size:11px">
                  {note.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
                </div>
                <h2 style="font-size:24px;margin-bottom:10px">
                  <a href={`/writing/friday-frame/${note.id}`} style="text-decoration:none">{note.data.title}</a>
                </h2>
                <p style="font-family:'Fraunces',serif;font-size:17px;line-height:1.55;color:var(--ink-soft);max-width:680px;margin:0">{note.data.summary}</p>
              </article>
            </li>
          ))}
        </ul>
      )}

      <p class="stub-note" style="margin-top:64px">
        <a href="/writing">← All writing</a>
      </p>
    </div>
  </section>
</BaseLayout>
