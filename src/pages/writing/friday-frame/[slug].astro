---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FridayFramePromo from '../../../components/FridayFramePromo.astro';
import ShareButtons from '../../../components/ShareButtons.astro';
import NotifySignup from '../../../components/NotifySignup.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const notes = await getCollection('fridayFrame', ({ data }) => !data.draft);
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);

const siteOrigin = (Astro.site?.toString() || 'https://adrianwatkins.com').replace(/\/$/, '');
const notePath = `/writing/friday-frame/${note.id}`;
const shareUrl = `${siteOrigin}${notePath}`;

// Pull the three most recent OTHER frames for the read-another block.
const allFrames = await getCollection('fridayFrame', ({ data }) => !data.draft);
const others = allFrames
  .filter((n) => n.id !== note.id)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: note.data.title,
  description: note.data.summary,
  datePublished: note.data.date.toISOString(),
  author: {
    '@type': 'Person',
    name: 'Adrian Watkins',
    url: 'https://adrianwatkins.com',
  },
  isPartOf: {
    '@type': 'Series',
    name: 'Friday Frame',
  },
};
---

<BaseLayout
  title={`${note.data.title}. Friday Frame. Adrian Watkins.`}
  description={note.data.summary}
  current="writing"
  ogType="article"
  ogImage="/og/friday-frame-default.png"
  ogImageAlt={`${note.data.title}. Friday Frame by Adrian Watkins.`}
  publishedTime={note.data.date.toISOString()}
  author="Adrian Watkins"
  articleSection="Friday Frame"
  jsonLd={articleJsonLd}
>
  <section class="stub">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/writing">← Writing</a>
        <span class="sep">/</span>
        <a href="/writing/friday-frame">Friday Frame</a>
      </nav>

      <FridayFramePromo variant="inline" currentSlug={note.id} />

      <div class="eyebrow">Writing / Friday Frame</div>
      <p style="font-size:13px;color:var(--muted);letter-spacing:0.04em;margin-bottom:18px">
        {note.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
      </p>
      <h1>{note.data.title}</h1>
      <p class="lede">{note.data.summary}</p>

      <div class="prose" style="font-family:'Fraunces',serif;font-size:18px;line-height:1.7;color:var(--ink);margin-top:40px">
        <Content />
      </div>

      <ShareButtons title={note.data.title} url={shareUrl} />

      <NotifySignup variant="card" source={notePath} />

      <FridayFramePromo variant="footer" currentSlug={note.id} />

      {others.length > 0 && (
        <section class="more-frames" style="margin-top:48px;padding-top:48px;border-top:1px solid var(--rule)">
          <h2 style="font-size:24px;margin-bottom:24px">More from the Friday Frame archive.</h2>
          <ul class="frame-cards">
            {others.map((n) => (
              <li>
                <a href={`/writing/friday-frame/${n.id}`} class="frame-card">
                  <div class="frame-card-date">
                    {n.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
                  </div>
                  <h3 class="frame-card-title">{n.data.title}</h3>
                  <p class="frame-card-summary">{n.data.summary.length > 140 ? n.data.summary.slice(0, 140) + '...' : n.data.summary}</p>
                </a>
              </li>
            ))}
          </ul>
          <p style="margin-top:28px">
            <a href="/writing/friday-frame" class="more">Read every Friday Frame →</a>
          </p>
        </section>
      )}

      <p class="stub-note" style="margin-top:48px">
        <a href="/writing/friday-frame">← All Friday Frames</a>
        <span style="margin:0 12px;color:var(--muted)">·</span>
        <a href="/writing">All writing</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .breadcrumb {
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--muted);
    margin-bottom: 8px;
  }
  .breadcrumb a {
    color: var(--muted);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  .breadcrumb .sep {
    margin: 0 8px;
    color: var(--muted);
    opacity: 0.6;
  }

  .frame-cards {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }
  .frame-card {
    display: block;
    padding: 20px;
    background: #FAF6EC;
    border: 1px solid var(--rule);
    border-radius: 2px;
    color: var(--ink);
    text-decoration: none;
    height: 100%;
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  .frame-card:hover {
    border-color: #D89A55;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px -10px rgba(26, 23, 20, 0.18);
  }
  .frame-card-date {
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 600;
    margin-bottom: 10px;
  }
  .frame-card-title {
    font-family: 'Fraunces', serif;
    font-size: 19px;
    line-height: 1.3;
    color: var(--ink);
    margin: 0 0 10px 0;
    font-weight: 600;
  }
  .frame-card-summary {
    font-family: 'Fraunces', serif;
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--ink-soft);
    margin: 0;
  }

  @media (max-width: 720px) {
    .breadcrumb .sep { margin: 0 6px; }
    .frame-cards { grid-template-columns: 1fr; }
  }
</style>
