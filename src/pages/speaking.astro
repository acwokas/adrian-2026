---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoSlot from '../components/PhotoSlot.astro';

const title = 'Speaking. Adrian Watkins.';
const description = 'Keynotes, workshops, and panels on applied intelligence, AI governance, and commercial leadership across Asia-Pacific. Engagements past and upcoming.';
---

<BaseLayout title={title} description={description} current="speaking">
  <section class="stub">
    <div class="container">
      <div class="eyebrow">Speaking</div>
      <h1>Engagements, past and upcoming.</h1>
      <p class="lede">Most speaker pages list the talk. This one will list the question I want the audience to leave with. If the question is not yours, the talk is not for you.</p>

      <PhotoSlot
        src="speaking-industry.jpg"
        alt="Adrian Watkins on stage at an industry conference. Wide shot."
        description="Industry conference. Wide stage shot."
        meta="Drop the JPG at /public/images/speaking-industry.jpg to populate."
        aspectRatio="16 / 9"
      />

      <PhotoSlot
        src="speaking-fireside.jpg"
        alt="Adrian Watkins in a fireside or panel format. Mid-shot."
        description="Fireside or panel format. Mid-shot, two or more seated speakers."
        meta="Drop the JPG at /public/images/speaking-fireside.jpg to populate."
        aspectRatio="3 / 2"
      />

      <p class="prose">Recent and upcoming engagements live on the home page in Phase 1. The full calendar, workshop outlines, prep notes, attendance numbers, attributed testimonials, and downloadable speaker pack ship in Phase 2.</p>

      <p class="stub-note">Full calendar, workshop outlines, attributed testimonials, and a downloadable speaker pack ship in Phase 2.</p>
      <!-- TODO: phase 2 - full chronological calendar, structured frontmatter (date, venue, attendance, link, quote), workshop outline section, prep notes, "the question I want the audience to leave with" per talk, downloadable speaker pack PDF, Schema.org Event JSON-LD per upcoming engagement -->
    </div>
  </section>
</BaseLayout>
