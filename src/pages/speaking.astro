---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import { PERSON_ID } from '../data/person';
import { entriesByBucket } from '../data/speaking';

const todayISO = new Date().toISOString().slice(0, 10);
const upcomingEntries = entriesByBucket('upcoming', todayISO);
const recentEntries = entriesByBucket('recent', todayISO);

const title = 'Speaking and contribution. Adrian Watkins.';
const description = 'Singapore-based Adrian Watkins contributes to industry conversations, executive roundtables and learning programmes on leadership, growth, governance and putting intelligence into action.';

const speakingJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Speaking. Adrian Watkins.',
  url: 'https://adrianwatkins.com/speaking',
  description,
  about: { '@id': PERSON_ID },
};
---

<BaseLayout title={title} description={description} current="speaking" ogImage="/images/speaking-government.jpg" jsonLd={speakingJsonLd}>
  <section class="stub" style="padding-bottom:48px">
    <div class="container">
      <div class="eyebrow">Speaking and contribution</div>
      <h1>Practical perspectives. Useful conversations.</h1>
      <p class="lede">I speak about building and growing technology businesses, turning intelligence into action, and making governance part of how organisations move forward.</p>
      <div class="prose" style="margin-top:24px">
        <p>My perspective comes from leading commercial operations across markets and building publications, data services and practical tools through <a href="https://democratising.ai/" target="_blank" rel="noopener noreferrer">democratising.ai</a>. Singapore is home, and my work connects local experience with regional and global commercial, regulatory and cultural contexts.</p>
        <p>Through selected industry conversations, executive roundtables and learning programmes, I aim to give people something useful to take into their next decision.</p>
      </div>
    </div>
  </section>

  <PhotoSlot
    src="speaking-ortus-roundtable-moderating.jpg"
    alt="Adrian Watkins moderating an Ortus Club CXO roundtable in Singapore"
    description="Moderating an Ortus Club CXO roundtable in Singapore."
    aspectRatio="3 / 2"
    caption="Moderating an Ortus Club CXO roundtable. Singapore, May 2026."
  />

  <PhotoSlot
    src="speaking-ortus-roundtable-wide.jpg"
    alt="Adrian Watkins moderating a 10-person executive roundtable, Ortus Club Singapore"
    description="Wide shot of a 10-person executive roundtable, Ortus Club Singapore."
    aspectRatio="3 / 2"
    caption="Ten-seat executive roundtable, Ortus Club. Singapore, May 2026."
  />

  <PhotoSlot
    src="speaking-government.jpg"
    alt="Adrian Watkins on stage opening the Taipei City Government Smart Living, Sustainable Future 2025 event."
    description="Adrian opening the Taipei City Government keynote at Smart Living, Sustainable Future 2025."
    aspectRatio="16 / 9"
    caption="Opening keynote, Smart Living, Sustainable Future 2025. Taipei City Government, November 2025."
  />

  <PhotoSlot
    src="speaking-fireside-taipei.jpg"
    alt="Adrian Watkins on a sofa with a microphone during the Smart Living, Sustainable Future 2025 fireside in Taipei."
    description="Fireside seat at Smart Living, Sustainable Future 2025."
    aspectRatio="3 / 2"
    caption="Fireside, Smart Living, Sustainable Future 2025. Taipei, November 2025."
  />

  <section style="padding:64px 0">
    <div class="container">
      <h2 style="margin-bottom:32px">Some of the topics I speak about.</h2>
      <div class="help" style="grid-template-columns:repeat(2,1fr)">
        <div class="help-card">
          <h4>One</h4>
          <h3>Leading growth and integration.</h3>
          <p>Aligning people, product, process and compliance as businesses scale. Drawing on my experience bringing three businesses together within SQREEM Technologies, improving commercial operations and supporting expansion across markets.</p>
        </div>
        <div class="help-card">
          <h4>Two</h4>
          <h3>Governance that enables progress.</h3>
          <p>Building accountability and privacy into commercial and operating decisions, so teams can move forward with clarity and confidence. Practical perspectives from group leadership and my expanded data protection remit (DPO).</p>
        </div>
        <div class="help-card">
          <h4>Three</h4>
          <h3>From intelligence to action with EDGE.</h3>
          <p>Applying evidence, experience and human judgement to everyday business situations. How <a href="/edge">EDGE</a> helps people evaluate a situation, define a direction, establish accountability and put learning into practice, with AI tools supporting the process where useful.</p>
        </div>
        <div class="help-card">
          <h4>Four</h4>
          <h3>Building useful services.</h3>
          <p>Lessons from DARE, the shared publishing and data platform behind <a href="https://democratising.ai/" target="_blank" rel="noopener noreferrer">democratising.ai</a>, and publications including <a href="https://aiinasia.com/" target="_blank" rel="noopener noreferrer">AIinASIA</a> and <a href="https://urbandogowner.com/" target="_blank" rel="noopener noreferrer">UrbanDogOwner</a>. Starting with where I call home, <a href="/singapore">Singapore</a>, and building on what we learn to serve audiences beyond it.</p>
        </div>
        <div class="help-card">
          <h4>Five</h4>
          <h3>Working across markets.</h3>
          <p>Adapting execution to local commercial, regulatory and cultural needs while maintaining a coherent regional or global direction. What to keep consistent, where to adapt and how to give local teams the context to make sound decisions.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="alt" style="padding:64px 0">
    <div class="container">
      <div class="section-head">
        <h2>Speaking calendar.</h2>
        <p class="aside">Upcoming and ongoing first, then recent. Selected dates.</p>
      </div>

      <div class="eyebrow" style="margin-bottom:18px">Upcoming and ongoing</div>
      <div class="speak">
        {upcomingEntries.map((entry) => (
          <div class="speak-card">
            <div class="when">{entry.when}</div>
            {entry.extraHtml ? (
              <Fragment set:html={entry.extraHtml} />
            ) : (
              <h3 set:html={entry.titleHtml} />
            )}
            <p set:html={entry.bodyHtml} />
          </div>
        ))}
      </div>

      <div class="eyebrow" style="margin:56px 0 18px 0">Recent</div>
      <div class="speak">
        {recentEntries.map((entry) => (
          <div class="speak-card">
            <div class="when">{entry.when}</div>
            {entry.extraHtml ? (
              <Fragment set:html={entry.extraHtml} />
            ) : (
              <h3 set:html={entry.titleHtml} />
            )}
            <p set:html={entry.bodyHtml} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <PhotoSlot
    src="speaking-industry.jpg"
    alt="Adrian Watkins delivering an industry welcome keynote with audience visible."
    description="Industry welcome keynote with audience visible."
    aspectRatio="16 / 9"
  />

  <section style="padding:64px 0">
    <div class="container">
      <h2 style="margin-bottom:24px">Shaped around the audience.</h2>
      <div class="prose">
        <p>I contribute to selected industry conversations, executive roundtables and learning programmes where my experience can be useful. The format follows the audience, purpose and scope, whether that is a keynote, panel, moderated discussion or practical session.</p>
        <p><a href="/singapore">Singapore</a> is home, and I particularly welcome opportunities to support local students and emerging business leaders through mentoring and guest teaching.</p>
      </div>

      <div style="margin-top:32px">
        <PhotoSlot
          src="speaking-workshop-blackstorm.jpg"
          alt="Adrian Watkins delivering the BlackStorm What is Marketing, Really? workshop. Adrian at a flipchart with the workshop title on screen."
          description="Mid-flow on the BlackStorm What is Marketing, Really? workshop."
          aspectRatio="4 / 3"
          caption="Workshop format. BlackStorm Group, What is Marketing, Really?"
        />
      </div>
    </div>
  </section>

  <PhotoSlot
    src="speaking-fireside.jpg"
    alt="Adrian Watkins moderating the startup panel at Smart Living, Sustainable Future 2025 in Taipei. Three seated speakers."
    description="Moderating the startup panel at Smart Living, Sustainable Future 2025 in Taipei."
    aspectRatio="3 / 2"
    caption="Panel discussion, Smart Living, Sustainable Future 2025 in Taipei."
  />

  <section class="dark" style="padding:80px 0">
    <div class="container">
      <h2 style="color:#F4ECD8;margin-bottom:20px">Start a conversation.</h2>
      <p style="color:#C4B89F;max-width:680px;font-family:'Fraunces',serif;font-size:20px;line-height:1.5;margin-bottom:32px">If my experience could be useful to your audience, get in touch with the topic, purpose and scope. We can explore the right format together.</p>
      <div class="ctarow">
        <a class="btn btn-primary" href="/contact" style="background:#D89A55;flex:0 0 auto">Get in touch</a>
        <a class="btn btn-secondary" href="https://www.linkedin.com/in/adrianwatkins/" target="_blank" rel="noopener noreferrer" style="border-color:#E9E2D2;color:#E9E2D2;display:inline-flex;align-items:center;gap:8px;flex:0 0 auto;min-width:auto">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43c-1.14 0-2.06-.93-2.06-2.06s.92-2.07 2.06-2.07 2.06.93 2.06 2.07c0 1.13-.92 2.06-2.06 2.06zm1.78 13.02H3.56V9h3.56v11.45z"/></svg>
          LinkedIn
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .speak-card {
    padding-top: 28px;
    border-top: 1px solid var(--rule-strong);
  }
</style>
