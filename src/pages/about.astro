---
import BaseLayout from '../layouts/BaseLayout.astro';
import DareLogo from '../components/DareLogo.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import { PERSON_ID } from '../data/person';

const title = 'About Adrian Watkins | The experience behind the work';
const description = 'Adrian Watkins: Singapore-based commercial and operating leader. SQREEM Technologies leadership, creator of EDGE and builder of DARE by democratising.ai.';

// ProfilePage anchored to the canonical Person entity defined in
// src/data/person.ts. Person + WebSite are emitted globally by
// BaseLayout; this ProfilePage block tells Google that /about is the
// authoritative profile surface for Adrian.
const profileJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': 'https://adrianwatkins.com/about#profile',
  url: 'https://adrianwatkins.com/about',
  name: 'About Adrian Watkins',
  description,
  mainEntity: { '@id': PERSON_ID },
  about: { '@id': PERSON_ID },
  primaryImageOfPage: {
    '@type': 'ImageObject',
    url: 'https://adrianwatkins.com/images/hero-portrait.jpg',
  },
  inLanguage: 'en-GB',
};
---

<BaseLayout title={title} description={description} current="about" jsonLd={profileJsonLd}>
<section class="about-intro">
  <div class="container">
    <div class="about-intro-grid">
      <div class="about-intro-copy">
        <div class="eyebrow">About</div>
        <h1>The experience behind the work.</h1>
        <p class="lede">I’m Adrian Watkins, a commercial and operating leader based in Singapore, with 25 years of experience across Asia, Europe and the US.</p>
        <p>I bring people, products and processes together to turn strategy into execution and create the conditions for businesses to grow.</p>
      </div>
      <div class="about-intro-photo">
        <PhotoSlot src="about-ortus-roundtable-moderating.jpg" alt="Adrian Watkins moderating an Ortus Club executive roundtable in Singapore." aspectRatio="3 / 2" loading="eager" caption="Exchanging perspectives at an Ortus Club executive roundtable. Singapore." />
      </div>
    </div>
    <ul class="about-focus" aria-label="Areas of experience">
      <li>Commercial leadership</li>
      <li>Building businesses</li>
      <li>Governance that enables progress</li>
    </ul>
  </div>
</section>
<section class="about-section"><div class="container"><h2>Leading across markets.</h2><div class="prose"><p>I lead commercial operations and governance across <a href="https://sqreem.com" target="_blank" rel="noopener noreferrer">SQREEM Technologies</a>. My remit brings together commercial priorities, operational delivery and the decisions that support growth across regions.</p>
<p>That has included sourcing the TotallyAwesome acquisition, helping broker the deal and leading commercial and operational integration. The wider work brought three businesses together within <a href="https://sqreem.com" target="_blank" rel="noopener noreferrer">SQREEM Technologies</a>, harmonising people, products, processes and compliance practices to support efficiencies, revenue growth and expansion, including into the US.</p>
<p>In the second half of 2026, I was also appointed a Data Protection Officer (DPO), formalising work I had been carrying out over the preceding year. It complements my wider leadership responsibilities, translating privacy requirements across jurisdictions into practical product, commercial and operating decisions.</p></div><div class="about-photo"><PhotoSlot src="team-sqreem.jpg" alt="Adrian Watkins with the SQREEM Technologies team in front of a SQREEM banner." aspectRatio="16 / 9" caption="With the SQREEM Technologies team. Singapore." /></div></div></section>
<section class="about-section alt"><div class="container"><h2>How I lead.</h2><div class="prose"><p>I believe people do their best work when they understand the direction, their responsibilities and how their contribution matters.</p>
<p>I bring teams together around shared priorities and stay involved as plans become delivery. Across markets, I look for the right balance between a consistent operating approach and local judgement, recognising differences in commercial expectations, regulation and working culture.</p>
<p>Governance is part of that approach. Done well, it gives people the clarity and confidence to move forward and helps anticipate issues before they become costly.</p>
<p>That thinking also informs <a href="/edge">EDGE</a>, the framework I created to help people turn knowledge, experience and insight into action.</p></div></div></section>
<section class="about-section"><div class="container"><h2>Career highlights.</h2><div class="career-grid"><article class="career-highlight"><div class="tag">One</div><h3>Commercial transformation and fundraising.</h3><p>At Tickled Media, now theParent Inc, I reported to the CEO and board and led approximately 100 people across presales, sales, product, delivery, studio, insights and technology. I brought those functions together around Brand Solutions, simplified the product offering and aligned sales and delivery incentives around work that clients valued and teams could deliver consistently. Alongside ongoing coaching, those changes helped drive 55% year-on-year company revenue growth.</p><p>I also co-led the Series C fundraising process with the CEO and founder, working with prospective investors, presenting commercial performance to Fosun and JD.com, and preparing teams across markets to explain their results, forecasts and growth plans.</p></article><article class="career-highlight"><div class="tag">Two</div><h3>Making new commercial ideas work.</h3><p>At AdColony, subsequently Digital Turbine, I helped reposition the regional business around gaming marketing. I co-led the strategy and mechanics for Unilever Closeup’s Mobile Legends: Bang Bang campaign, which launched in the Philippines and expanded across multiple Southeast Asian markets. My responsibilities included negotiations with the media agency, Moonton and Unilever, bringing together IP permissions, commercial terms and practical protections for delivery.</p></article><article class="career-highlight"><div class="tag">Three</div><h3>International expansion and integration.</h3><p>At FOX and IGN Entertainment, I developed the commercial case for international expansion through owned operations, partnerships and franchises. Markets outside North America and Australia grew from approximately 1% to 10% of IGN’s global revenue within 12 months.</p><p>I co-led the acquisition of GIGA.de and ran the German business through the integration of editorial, technology, sales and monetisation capabilities. That included launching IGN Germany at Gamescom and establishing localised publishing and advertising capabilities that supported regional campaigns sold from London.</p><p><a href="/work#ign">Read the IGN case study</a></p></article><article class="career-highlight"><div class="tag">Four</div><h3>Building a business through to exit.</h3><p>I co-owned DigiReward and led its UK operation, developing partnerships with Warner Bros, cinema chains and Tesco Clubcard. Together with the mainland Europe operation led by my co-owner, we grew the business to more than 60 international clients and an annual revenue run rate exceeding £1 million within 12 months. We co-led its sale to an adtech company within two years.</p></article><article class="career-highlight"><div class="tag">Five</div><h3>A foundation in commercial partnerships and reusable platforms.</h3><p>At Virgin Media, I secured multi-year partnerships worth several million pounds annually ahead of the new website launch. Earlier, I helped launch VisitLondon.com and then brought that experience to CIPD, commissioning a reusable content management system and training staff to work digitally. Replacing repeated bespoke builds delivered £1 million in realised annual savings at CIPD.</p><p>That experience continues to inform how I build today: understand what people need, create a foundation that can be reused, and make sure the organisation can put it to work.</p></article></div><p class="about-related"><a href="/documents/Adrian-Watkins-Executive-CV-2026.pdf" target="_blank" rel="noopener noreferrer">Full career history in my executive CV ↗</a></p></div></section>
<section class="about-section alt"><div class="container"><h2>What I build.</h2><div class="prose"><p>I enjoy taking an idea through to something people can use.</p>
<p>Through <a href="https://democratising.ai/" target="_blank" rel="noopener noreferrer">democratising.ai</a>, I have built a portfolio of publications, data services and practical tools powered by DARE, my shared publishing and data platform. DARE stands for Data, AI, Research and Execution.</p>
<p>It brings together data collection, publishing, source checks and monitoring. Continuing to improve that foundation lets me apply learning across the portfolio while adapting each service to its audience.</p>
<p>In Singapore, that includes <a href="https://urbandogowner.com/" target="_blank" rel="noopener noreferrer">Urban Dog Owner</a> and services such as <a href="https://payline.sg/" target="_blank" rel="noopener noreferrer">PayLine</a>, <a href="https://coewatch.sg/" target="_blank" rel="noopener noreferrer">COEwatch</a> and <a href="https://duedate.sg/" target="_blank" rel="noopener noreferrer">DueDate</a>. Across the wider region and beyond, <a href="https://aiinasia.com/" target="_blank" rel="noopener noreferrer">AIinASIA</a>, <a href="https://aiinarabia.com/" target="_blank" rel="noopener noreferrer">AIinArabia</a> and <a href="https://aiineurope.co/" target="_blank" rel="noopener noreferrer">AIinEurope</a> bring local context to developments in technology and business.</p>
<p><a href="/edge">EDGE</a> connects another part of that work: a framework for clearer thinking, better decisions and effective execution, supported by tools that help people explore, prepare and reflect.</p>
<p>Building these services keeps me close to the practical decisions behind a product, from its purpose and audience to how it operates and improves.</p></div><aside class="dare-callout"><DareLogo /><p><strong>Data. AI. Research. Execution.</strong></p><p>Dare to put ideas into practice.</p></aside></div></section>
<section class="about-section"><div class="container"><h2>Singapore is home.</h2><div class="prose"><p>Singapore is where I live, work and contribute. My ambition is to make everyday decisions a little easier to navigate, starting with the place I call home.</p>
<p>That takes different forms: helping students develop their ideas, working with founders, bringing business leaders into conversation and building useful information services for people and local businesses.</p>
<p>Recent contributions include student mentoring through SDG Open Hack, founder workshops with the <a href="https://www.nlb.gov.sg/" target="_blank" rel="noopener noreferrer">National Library Board</a> and <a href="https://blackstormco.asia/" target="_blank" rel="noopener noreferrer">BlackStorm Group</a>, and executive moderation with the <a href="https://www.ortusclub.com/moderator/why-is-democratising-the-room-the-most-underrated-skill-in-executive-moderation-adrian-watkins-sqreem-technologies/" target="_blank" rel="noopener noreferrer">Ortus Club</a>.</p>
<p>I also support founders through regional programmes and have recently been appointed a mentor with the <a href="https://aseanfoundation.org/" target="_blank" rel="noopener noreferrer">ASEAN Foundation</a>’s ASEAN SOAR Together programme. Those relationships extend my contribution beyond Singapore and bring different perspectives back into my work here.</p></div><div class="ctarow"><a class="btn btn-primary" href="/singapore">My contribution in Singapore</a><a class="btn btn-secondary" href="/speaking">Speaking and conversations</a></div></div></section>
<section class="about-section"><div class="container"><h2>A commercial and operating perspective for boards.</h2><div class="prose">
<p>I bring experience of growing businesses, integrating acquisitions and leading across markets, together with a practical understanding of technology and data governance.</p>
<p>That perspective is useful when a board is considering expansion, the quality of revenue, a partnership or acquisition, or the operating implications of a strategic decision. I connect commercial ambition with the people, capabilities and accountability needed to deliver it.</p>
<p>My work across Asia, Europe and the US has reinforced the importance of informed local judgement within a clear overall direction. Alongside my executive remit, my data protection responsibilities keep me close to the changing expectations around how technology businesses use information.</p>
<p>I welcome conversations about non-executive director (NED) and advisory roles where that experience could contribute, with scope and time commitments shaped around the organisation’s needs and my executive responsibilities.</p>
</div><div class="ctarow"><a class="btn btn-primary" href="/contact">Start a conversation</a></div></div></section>
<section class="about-section alt"><div class="container"><h2>Beyond work.</h2><div class="prose"><p>Music, reading and football are regular parts of my life. I enjoy ideas that give me a different perspective, whether they come from a book, a podcast or a conversation.</p>
<p>I’m a Manchester United fan, although that loyalty does not always make selecting my Fantasy football team straightforward.</p></div><p class="about-related"><a href="/now">What I’m reading, listening to and thinking about</a></p></div></section>
<section class="about-section"><div class="container"><h2>Let’s connect.</h2><div class="prose"><p>I welcome conversations with people leading teams, building businesses and putting ideas into practice.</p>
<p>For mentoring, guest sessions, speaking or a shared interest, I’d be glad to hear from you.</p></div><div class="ctarow"><a class="btn btn-primary" href="/contact">Get in touch</a><a class="btn btn-secondary" href="/documents/Adrian-Watkins-Executive-CV-2026.pdf" target="_blank" rel="noopener noreferrer">View my executive CV</a><a class="btn btn-secondary" href="https://www.linkedin.com/in/adrianwatkins/" target="_blank" rel="noopener noreferrer">Connect on LinkedIn</a></div></div></section>
</BaseLayout>
<style>
.about-intro { padding: 64px 0 40px; }
.about-intro-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
.about-intro-copy h1 { font-size: clamp(36px, 4vw, 54px); margin: 18px 0 24px; }
.about-intro-copy .lede { font-size: 21px; margin-bottom: 20px; }
.about-intro-copy > p:last-child { margin-bottom: 0; }
.about-intro-photo :global(.speak-media) { margin: 0; }
.about-focus { display: flex; flex-wrap: wrap; gap: 16px 32px; list-style: none; padding: 24px 0 0; margin: 36px 0 0; border-top: 1px solid var(--rule); font-size: 13px; color: var(--ink-soft); }
.about-focus li { padding-left: 14px; border-left: 2px solid #D89A55; }
@media (max-width: 760px) {
  .about-intro { padding: 40px 0 32px; }
  .about-intro-grid { grid-template-columns: 1fr; gap: 28px; }
  .about-focus { gap: 14px; margin-top: 24px; }
}

.about-section { padding: 56px 0; }
.about-section h2 { margin-bottom: 24px; }
.about-photo { max-width: 800px; margin-top: 36px; }
.career-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 40px; }
.career-highlight { border-top: 1px solid var(--line, #b8ad98); padding-top: 24px; }
.career-highlight h3 { margin: 10px 0 16px; }
.career-highlight p { margin-bottom: 16px; }
.dare-callout { max-width: 760px; margin-top: 28px; padding: 24px; border-left: 3px solid var(--accent); background: var(--bg); }
.dare-callout p:last-child { margin-bottom: 0; }
.about-related { margin-top: 24px; }
@media (max-width: 880px) { .career-grid { grid-template-columns: 1fr; } }
</style>
