---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = 'Executive CV | Adrian Watkins';
const description = 'Adrian Watkins: commercial and operating leadership, business and AI transformation. Download the executive CV.';
---
<BaseLayout title={title} description={description}>
  <section class="stub">
    <div class="container">
      <div class="eyebrow">Executive CV</div>
      <h1>Operator. Builder. Governor.</h1>
      <p class="lede">I build and lead technology businesses, connecting commercial strategy, day-to-day operations and governance to make business and AI transformation work in practice.</p>
      <p class="prose">Based in Singapore. More than 25 years of experience across Asia, Europe and the US.</p>
      <div class="ctarow" style="margin-top:28px">
        <a class="btn btn-primary" href="/documents/Adrian-Watkins-Executive-CV-2027.pdf" target="_blank" rel="noopener noreferrer" download>Download my executive CV (PDF)</a>
        <a class="btn btn-secondary" href="/work">Explore my leadership work</a>
      </div>
      <p class="quiet" style="margin-top:20px">For a conversation, <a href="/contact">get in touch</a>.</p>
    </div>
  </section>
</BaseLayout>
