---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Page not found. Adrian Watkins.';
const description = 'That page does not exist on adrianwatkins.com. Try /writing for essays or / for the home page.';
---

<BaseLayout title={title} description={description}>
  <section class="stub" style="padding:96px 0">
    <div class="container" style="text-align:left">
      <div class="eyebrow">404</div>
      <h1>Not found.</h1>
      <p class="lede">That page is not here. The site was recently rebuilt so a URL may have moved. Try one of these instead.</p>

      <div class="ctarow" style="margin-top:32px">
        <a class="btn btn-primary" href="/">Home</a>
        <a class="btn btn-secondary" href="/about">About</a>
        <a class="btn btn-secondary" href="/writing">Writing</a>
        <a class="btn btn-secondary" href="/singapore">Singapore</a>
      </div>
    </div>
  </section>
</BaseLayout>
