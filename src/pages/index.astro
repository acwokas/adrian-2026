---
import BaseLayout from '../layouts/BaseLayout.astro';
import DareLogo from '../components/DareLogo.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import { digestParagraphs } from '../data/now';
import { homepageEntries } from '../data/speaking';


const todayISO = new Date().toISOString().slice(0, 10);
const homeUpcoming = homepageEntries('upcoming', todayISO);
const homeRecent = homepageEntries('recent', todayISO);

const title = 'Adrian Watkins. Operator. Builder. Governor.';
const description = 'Adrian Watkins: Singapore-based commercial and operating leader at SQREEM Technologies. Growth, integration and governance across regional and global markets.';

// Person + WebSite JSON-LD is emitted globally via BaseLayout
// (src/data/person.ts). No need to duplicate here.
---

<BaseLayout title={title} description={description} current="home">

  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-text">
          <div class="eyebrow">Singapore-based. Global perspective. Regional and local understanding.</div>
          <h1>Operator. Builder.<br /><em>Governor.</em></h1>
          <p class="lede">I build and lead technology businesses, connecting commercial strategy, day-to-day operations and governance across markets. My approach combines global ambition with an understanding of regional differences and local commercial, regulatory and cultural realities.</p>
          <div class="manifesto prose">
            <p>I’m SVP Commercial Operations and Governance at <a href="https://sqreem.com" target="_blank" rel="noopener noreferrer">SQREEM Technologies</a>. My work spans growth, acquisition integration and cross-functional leadership, alongside responsibilities as a Data Protection Officer (DPO). I help translate privacy obligations across jurisdictions into practical decisions about how the business operates.</p>

            <p>Through <a href="https://www.democratising.ai" target="_blank" rel="noopener noreferrer">democratising.ai</a>, I build tools, frameworks and publications that help people and organisations put AI to practical use. These include my <a href="/edge">EDGE framework</a> and <a href="https://aiinasia.com" target="_blank" rel="noopener noreferrer">AIinASIA</a>, informed by the different markets, languages and working cultures in which technology needs to succeed.</p>

            <p><a href="/singapore">Singapore is home.</a> Alongside my executive responsibilities, I mentor students, deliver founder workshops and moderate discussions with business leaders. That contribution extends into regional mentoring programmes and speaking engagements, connecting my work here with communities across Asia.</p>

            <p>I welcome conversations about regional and global leadership, business growth and the practical challenges of running technology organisations.</p>
          </div>

          <div class="ctarow">
            <a class="btn btn-primary" href="/contact">Get in touch</a>
            <a class="btn btn-secondary" href="/about">Explore my experience</a>
          </div>

          <div class="meta-line">
            <span>SVP Commercial Operations and Governance, <a href="https://sqreem.com" target="_blank" rel="noopener noreferrer">SQREEM Technologies</a></span>
            <span>Founder, <a href="https://democratising.ai" target="_blank" rel="noopener noreferrer">democratising.ai</a></span>
            <span>Publisher, <a href="https://aiinasia.com" target="_blank" rel="noopener noreferrer">AIinASIA.com</a></span>
            <span>Mentor, SDG Open Hack 2026</span>
            <span>Moderator, <a href="https://ortusclub.com" target="_blank" rel="noopener noreferrer">Ortus Club</a></span>
            <span>Creator, <a href="/edge">EDGE Framework</a></span>
          </div>
        </div>

        <figure class="hero-photo">
          <img src="/images/hero-portrait.jpg" alt="Adrian Watkins. Black-and-white editorial portrait. Singapore." />
          <figcaption>Singapore, 2025.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section id="work" class="alt">
    <div class="container">
      <div class="section-head">
        <h2>Selected work.</h2>
        <p class="aside">Leading businesses across markets and building useful services from Singapore, the place I call home.</p>
      </div>
      <div class="work-features">
        <article class="work-feature">
          <div class="tag">One / Commercial leadership</div>
          <h3>Bringing businesses together.</h3>
          <p>At <a href="https://sqreem.com" target="_blank" rel="noopener noreferrer">SQREEM Technologies</a>, I lead global commercial operations and governance. Integrating three businesses has meant harmonising people, products, processes and compliance to support growth across regions, including the US.</p>
          <p>Clearer contracts, pricing and approvals give regional leaders room to act, with margin discipline and accountability built in.</p>
          <h4>An expanded remit in data protection.</h4>
          <p>Appointed a Data Protection Officer (DPO) in the second half of 2026, I translate cross-market privacy requirements into practical commercial and product decisions alongside my wider remit.</p>
        </article>
        <article class="work-feature">
          <div class="tag">Two / Commercial transformation</div>
          <h3>Aligning teams around growth.</h3>
          <p>At <a href="https://theparentinc.com" target="_blank" rel="noopener noreferrer">theParent Inc</a>, I led approximately 100 people across commercial, product, delivery and technology. Simpler products, shared sales and delivery incentives, and sustained coaching helped drive 55% year-on-year company revenue growth.</p>
          <p>After strengthening execution in Thailand, I relocated to establish sales operations in Indonesia. It became the company’s highest-revenue country market in its first full year.</p>
          <a class="work-link" href="/about">More career highlights</a>
        </article>
        <article class="work-feature">
          <div class="tag">Three / Products and public data</div>
          <h3>Built in Singapore. Useful here and beyond.</h3>
          <p>My ambition is to make everyday decisions a little easier, starting where I call home. Through <a href="https://democratising.ai" target="_blank" rel="noopener noreferrer">democratising.ai</a>, I build services grounded in local context and linked to relevant sources.</p>
          <ul class="work-services">
            <li><a href="https://urbandogowner.com" target="_blank" rel="noopener noreferrer">Urban Dog Owner</a><span>Adoption, everyday care and local discovery</span></li>
            <li><a href="https://payline.sg" target="_blank" rel="noopener noreferrer">PayLine</a><span>Singapore salary and hiring data</span></li>
            <li><a href="https://coewatch.sg" target="_blank" rel="noopener noreferrer">COEwatch</a><span>COE bidding results</span></li>
            <li><a href="https://duedate.sg" target="_blank" rel="noopener noreferrer">DueDate</a><span>Business deadlines</span></li>
          </ul>
          <a class="work-link" href="/singapore">My contribution in Singapore</a>
        </article>
        <article class="work-feature">
          <div class="tag">Four / Reusable foundations</div>
          <h3>One platform. Many useful applications.</h3>
          <DareLogo />
          <p>DARE by <a href="https://democratising.ai" target="_blank" rel="noopener noreferrer">democratising.ai</a> stands for Data, AI, Research and Execution. It is the shared publishing and data platform I built to bring together collection, publishing, source checks and monitoring.</p>
          <p>Improvements carry across the portfolio, with sources and editorial context adapted for <a href="https://aiinasia.com" target="_blank" rel="noopener noreferrer">Asia</a>, <a href="https://aiinarabia.com" target="_blank" rel="noopener noreferrer">the Arab world</a> and <a href="https://aiineurope.co" target="_blank" rel="noopener noreferrer">Europe</a>.</p>
          <p><strong>25,000 monthly visitors</strong> to <a href="https://aiinasia.com" target="_blank" rel="noopener noreferrer">AIinASIA</a>, built over four years without paid distribution.</p>
          <a class="work-link" href="https://democratising.ai" target="_blank" rel="noopener noreferrer">Explore democratising.ai ↗</a>
        </article>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="section-head">
        <h2>How I operate.</h2>
        <p class="aside">Connect the ambition to the decisions, people and operating discipline that make it happen.</p>
      </div>
      <div class="help">
        <div class="help-card">
          <h4>One</h4>
          <h3>Strategy into execution.</h3>
          <p>I connect commercial priorities to clear plans, accountable teams and day-to-day decisions. From acquisition integration to entering new markets, I stay involved as strategy becomes delivery.</p>
        </div>
        <div class="help-card">
          <h4>Two</h4>
          <h3>People, products and processes.</h3>
          <p>I bring teams together around shared priorities, aligning how people work, how products serve customers and how the business operates. The aim is to create the conditions for people and the organisation to grow.</p>
        </div>
        <div class="help-card">
          <h4>Three</h4>
          <h3>Global perspective. Local understanding.</h3>
          <p>I work across markets with different commercial expectations, regulatory environments and working cultures. I look for what should be consistent across the business and where local judgement makes the difference.</p>
        </div>
        <div class="help-card">
          <h4>Four</h4>
          <h3>Governance that enables progress.</h3>
          <p>I build governance into product, commercial and operational decisions from the outset. Clear accountability and practical guardrails help teams move quickly, make informed decisions and anticipate issues before they become costly. My <a href="/edge">EDGE framework</a> and data protection responsibilities put that approach into practice.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="edge" class="dark">
    <div class="container">
      <div class="section-head">
        <h2 style="color:#F4ECD8">The EDGE Framework.</h2>
        <p class="aside" style="color:#B7A98E">A practical framework for clearer thinking, better decisions and effective execution.</p>
      </div>

      <div class="edge-intro">
        <p>I created EDGE to help people turn knowledge, experience and insight into action. It can be applied to a business decision, a team priority, a communication or a wider organisational initiative.</p>
        <p>Four connected pillars give that work structure.</p>
      </div>

      <div class="pillars">
        <div class="pillar">
          <div class="num">01</div>
          <h3>Evaluate.</h3>
          <p>Understand the situation, explore the evidence and test your assumptions. Bring the opportunity, context and choices into focus.</p>
        </div>
        <div class="pillar">
          <div class="num">02</div>
          <h3>Define.</h3>
          <p>Clarify what you want to achieve. Shape the priorities, message and measures of success so everyone understands the direction.</p>
        </div>
        <div class="pillar">
          <div class="num">03</div>
          <h3>Govern.</h3>
          <p>Build clear accountability and practical guardrails into the approach. Help people move confidently, with informed decisions and shared expectations.</p>
        </div>
        <div class="pillar">
          <div class="num">04</div>
          <h3>Elevate.</h3>
          <p>Apply what you learn to improve the outcome. Strengthen the decision, develop capability and carry that learning into what comes next.</p>
        </div>
      </div>

      <div class="edge-tools-copy">
        <h3>Practical tools. Human judgement.</h3>
        <p>Alongside the framework, I have created AI-powered tools to help people apply it to specific business situations.</p>
        <p>Explore a decision and its possible consequences with <a href="https://democratising.ai/tools/decision-simulation" target="_blank" rel="noopener noreferrer">Decision Simulation</a>, sharpen a message with <a href="https://democratising.ai/tools/before-you-send" target="_blank" rel="noopener noreferrer">Before You Send</a>, or prepare for an important discussion with the <a href="https://democratising.ai/tools/conversation-simulator" target="_blank" rel="noopener noreferrer">Conversation Simulator</a> and <a href="https://democratising.ai/tools/negotiation-simulator" target="_blank" rel="noopener noreferrer">Negotiation Simulator</a>.</p>
        <p>The tools support exploration, rehearsal and reflection. You bring the context, exercise judgement and decide how to act.</p>
      </div>

      <div class="ctarow" style="margin-top:32px">
        <a class="btn btn-primary" href="https://democratising.ai/tools" target="_blank" rel="noopener noreferrer" style="background:#D89A55;color:#1A1714">Explore the EDGE tools</a>
        <a class="btn btn-secondary" href="/documents/EDGE-Framework-Whitepaper.pdf" target="_blank" rel="noopener noreferrer" style="border-color:#E9E2D2;color:#E9E2D2">Read the EDGE white paper</a>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="now-grid">
        <div class="label">
          <h2><a href="/now" class="now-heading-link">/now.</a></h2>
          <p>My current focus, from Singapore and across the markets I work in.</p>
        </div>
        <div class="body">
          {digestParagraphs.map((p) => (<p>{p}</p>))}
          <p class="now-cta"><a href="/now" class="now-cta-link">Read the full /now log →</a></p>
        </div>
      </div>
    </div>
  </section>

  <section id="writing" class="alt">
    <div class="container">
      <div class="section-head">
        <h2>Explore.</h2>
        <p class="aside">Ideas, conversations and contributions from Singapore and across the markets I work in.</p>
      </div>
      <div class="slots">
        <article class="slot">
          <h3>Writing.</h3>
          <p>Perspectives on leadership, business, technology and governance. Longer essays alongside Friday Frame, my regular reflections on what has caught my attention.</p>
          <a class="more" href="/writing">Explore my writing</a>
        </article>
        <article class="slot">
          <h3>Speaking and conversations.</h3>
          <p>Keynotes, panels, workshops and executive moderation. Bringing people together to exchange perspectives and connect ideas with practical decisions.</p>
          <a class="more" href="/speaking">View speaking and events</a>
        </article>
        <article class="slot">
          <h3>Singapore.</h3>
          <p>The place I call home. My work with students, founders and business communities, alongside the useful services I’m building here.</p>
          <a class="more" href="/singapore">Explore my contribution</a>
        </article>
        <article class="slot">
          <h3>Right now.</h3>
          <p>What I’m working on, reading and listening to, plus the ideas and interests holding my attention.</p>
          <a class="more" href="/now">See what’s current</a>
        </article>
      </div>
    </div>
  </section>

  <section id="feature" class="alt">
    <div class="container">
      <div class="section-head">
        <h2>Recent feature.</h2>
        <p class="aside">A longer conversation on the craft behind the work.</p>
      </div>
      <article class="case">
        <div style="display:flex;align-items:flex-start;gap:14px;margin-bottom:14px">
          <img src="/images/logos/ortus-club.png" alt="Ortus Club logo" width="44" height="44" style="flex:0 0 44px;width:44px;height:44px;border-radius:6px;background:#000;display:block" />
          <div class="tag" style="margin:0">Interview, Ortus Club</div>
        </div>
        <h3><a href="https://www.ortusclub.com/moderator/why-is-democratising-the-room-the-most-underrated-skill-in-executive-moderation-adrian-watkins-sqreem-technologies/" target="_blank" rel="noopener noreferrer">Why is democratising the room the most underrated skill in executive moderation?</a></h3>
        <p>Ortus Club sat down with Adrian on the craft of executive moderation: preparation, reading the room, and giving the quietest person at the table a way in.</p>
        <blockquote style="margin:18px 0;padding-left:26px;border-left:3px solid #D89A55;font-style:italic">"My job is not to be the smartest person in the room. It is to make sure the table's intelligence is evenly distributed, and that everybody who wants to have a say has a say."</blockquote>
        <div class="meta"><a class="meta-link" href="https://www.ortusclub.com/moderator/why-is-democratising-the-room-the-most-underrated-skill-in-executive-moderation-adrian-watkins-sqreem-technologies/" target="_blank" rel="noopener noreferrer">Read the interview on Ortus Club</a></div>
      </article>
    </div>
  </section>

  <section id="speaking">
    <div class="container">
      <div class="section-head">
        <h2>Upcoming and recent.</h2>
        <p class="aside">Selected engagements. Full calendar on the speaking page.</p>
      </div>

      <PhotoSlot
        src="speaking-government.jpg"
        alt="Adrian Watkins on stage opening the Taipei City Government Smart Living, Sustainable Future 2025 event."
        description="Adrian opening the Taipei City Government keynote at Smart Living, Sustainable Future 2025."
        aspectRatio="16 / 9"
        caption="Opening keynote, Smart Living, Sustainable Future 2025. Taipei City Government, November 2025."
      />

      <div class="eyebrow" style="margin-bottom:18px">Upcoming and ongoing</div>
      <div class="speak">
        {homeUpcoming.map((entry) => (
          <div class="speak-card">
            <div class="when">{entry.homepage.when ?? entry.when}</div>
            <h3 set:html={entry.homepage.titleHtml} />
            <p set:html={entry.homepage.bodyHtml} />
          </div>
        ))}
      </div>

      <div class="eyebrow" style="margin:40px 0 18px 0">Recent</div>
      <div class="speak">
        {homeRecent.map((entry) => (
          <div class="speak-card">
            <div class="when">{entry.homepage.when ?? entry.when}</div>
            <h3 set:html={entry.homepage.titleHtml} />
            <p set:html={entry.homepage.bodyHtml} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="talk-section alt" id="contact">
    <div class="container talk-grid">
      <div class="talk-heading">
        <div class="eyebrow">Conversations and connections</div>
        <h2>Let’s talk.</h2>
      </div>
      <div class="talk-copy">
        <p class="talk-intro">I’m always interested in exchanging perspectives with people leading teams, building businesses and putting ideas into practice.</p>
        <p>I also welcome conversations about non-executive director (NED) and advisory roles where my commercial, operating and governance experience could contribute.</p>
        <p>Whether you have something to explore together, an invitation to contribute or simply a shared interest, I’d be glad to hear from you.</p>
        <a class="btn btn-primary talk-button" href="/contact">Get in touch</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .talk-section { padding: 64px 0; border-top: 1px solid var(--rule); }
  .talk-grid { display: grid; grid-template-columns: 1fr 2fr; gap: 48px; align-items: start; }
  .talk-heading h2 { margin-top: 12px; }
  .talk-copy { max-width: 65ch; }
  .talk-copy p { margin-bottom: 20px; }
  .talk-intro { font-family: var(--serif); font-size: 24px; line-height: 1.45; }
  .talk-button { display: inline-flex; width: auto; margin-top: 8px; }
  @media (max-width: 760px) { .talk-grid { grid-template-columns: 1fr; gap: 24px; } }

  .edge-intro, .edge-tools-copy { max-width: 80ch; color: #F4ECD8; }
  .edge-tools-copy { margin-top: 40px; }
  .edge-tools-copy h3 { color: #F4ECD8; }
  .edge-tools-copy a { color: #F4ECD8; text-decoration: underline; text-underline-offset: 3px; }
  .edge-tools-copy a:hover { color: #D89A55; }
  .work-features { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 48px 40px; }
  .work-feature { border-top: 1px solid var(--line, #b8ad98); padding-top: 24px; min-width: 0; }
  .work-feature h3 { margin: 10px 0 16px; }
  .work-feature h4 { text-transform: none; letter-spacing: normal; font-size: 17px; font-weight: 700; margin: 24px 0 10px; }
  .work-feature p { margin-bottom: 16px; }
  .work-link { display: inline-block; margin-top: 8px; }
  .work-services { list-style: none; padding: 0; margin: 20px 0; }
  .work-services li { display: grid; grid-template-columns: 145px 1fr; gap: 12px; padding: 9px 0; border-bottom: 1px solid var(--line, #d5cbbc); }
  .work-services span { font-size: 14px; }
  @media (max-width: 760px) {
    .work-features { grid-template-columns: 1fr; gap: 36px; }
    .work-services li { grid-template-columns: 1fr; gap: 3px; }
  }
</style>
