---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import { digestParagraphs, lastUpdatedHuman } from '../data/now';
import { homepageEntries } from '../data/speaking';
import { currentCardLine } from '../data/reading';

const todayISO = new Date().toISOString().slice(0, 10);
const homeUpcoming = homepageEntries('upcoming', todayISO);
const homeRecent = homepageEntries('recent', todayISO);

const title = 'Adrian Watkins. Operator. Builder. Governor.';
const description = 'Adrian Watkins. Senior commercial and operating leader across Asia, Europe, and the US. 25 years, the last fifteen building and scaling organisations. Creator of the EDGE Framework for Applied Intelligence. SVP Commercial Operations and Governance, SQREEM Technologies.';

// Person + WebSite JSON-LD is emitted globally via BaseLayout
// (src/data/person.ts). No need to duplicate here.
---

<BaseLayout title={title} description={description} current="home">

  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-text">
          <div class="eyebrow">Singapore. 25 years across Asia, Europe, and the US.</div>
          <h1>Operator. Builder.<br /><em>Governor.</em></h1>
          <p class="lede">Commercial and operational leadership across Asia, Europe, and the US. Twenty-five years building and scaling organisations, leading cross-functional teams, and taking strategy through to execution.</p>

          <div class="manifesto prose">
            <p>I have spent 25 years building and running commercial and product organisations across Asia, Europe, and the US. The last five have been about one question. Why do most organisations adopt AI like they are buying stationery, then act surprised when nothing compounds?</p>

            <p>I built EDGE to answer that question for the teams I lead, and to give boards a working language for AI capability that does not collapse the first time someone asks "but what did it actually do?".</p>

            <p>I am SVP Commercial Operations and Governance at SQREEM Technologies, an AI and data company. I sourced and led the integration of the TotallyAwesome acquisition in 2024, taking two commercial stacks and turning them into one product organisation. I also publish <a href="https://aiinasia.com" target="_blank" rel="noopener noreferrer">AIinASIA.com</a>, which reaches around 25,000 readers a month without paid distribution, and I built <a href="https://promptandgo.ai" target="_blank" rel="noopener noreferrer">PromptAndGo.ai</a> because Asia deserves AI prompts that respect the register, the market, and the language. These all sit under <a href="https://www.democratising.ai" target="_blank" rel="noopener noreferrer">democratising.ai</a>, a wider effort to make AI accessible and practical across every market I work in.</p>

            <p>I am always glad to talk with people building at the intersection of product, AI, and operations, whether that is a specific problem, a partnership, or just comparing notes on what is actually working.</p>
          </div>

          <div class="ctarow">
            <a class="btn btn-primary" href="/contact">Get in touch</a>
            <a class="btn btn-secondary" href="/edge">Read the EDGE framework</a>
          </div>

          <div class="meta-line">
            <span>SVP Commercial Operations and Governance, <a href="https://sqreem.com" target="_blank" rel="noopener noreferrer">SQREEM Technologies</a></span>
            <span>Advisor, <a href="https://blackstormco.asia" target="_blank" rel="noopener noreferrer">BlackStorm Group</a></span>
            <span>Coach, <a href="https://beyond4.tech/" target="_blank" rel="noopener noreferrer">Beyond4Tech</a></span>
            <span>Publisher, <a href="https://aiinasia.com" target="_blank" rel="noopener noreferrer">AIinASIA.com</a></span>
            <span>Moderator, <a href="https://ortusclub.com" target="_blank" rel="noopener noreferrer">Ortus Club</a></span>
            <span>Builder, <a href="https://promptandgo.ai" target="_blank" rel="noopener noreferrer">PromptAndGo.ai</a></span>
          </div>
        </div>

        <figure class="hero-photo">
          <img src="/images/hero-portrait.jpg" alt="Adrian Watkins. Black-and-white editorial portrait. Singapore." />
          <figcaption>Singapore, 2025.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section id="work" class="alt">
    <div class="container">
      <div class="section-head">
        <h2>Selected work.</h2>
        <p class="aside">Three named engagements where the public record speaks for itself. The longer list, with anonymised cases, sits on the work page.</p>
      </div>
      <div class="cases">

        <article class="case">
          <div class="tag">M&amp;A integration, 2024</div>
          <h3>SQREEM acquires TotallyAwesome.</h3>
          <p>I sourced the target, helped broker the deal, and led the go-to-market and operational integration. Two commercial stacks became one, with governance controls in place from day one. The internal lessons sit in the EDGE Govern pillar.</p>
          <div class="meta">Public commentary on the acquisition is on record.</div>
        </article>

        <article class="case">
          <div class="tag">Owned media, since 2020</div>
          <h3><a href="https://aiinasia.com" target="_blank" rel="noopener noreferrer">AIinASIA.com</a>.</h3>
          <p>I founded and publish <a href="https://aiinasia.com" target="_blank" rel="noopener noreferrer">AIinASIA</a>, an editorial brief on how artificial intelligence is actually being adopted across Asia-Pacific, and I have since extended the format into <a href="https://aiinarabia.com" target="_blank" rel="noopener noreferrer">AIinArabia</a> and <a href="https://aiineurope.co" target="_blank" rel="noopener noreferrer">AIinEurope</a>. Around 25,000 readers a month on AIinASIA alone, zero paid distribution, written for operators rather than tourists.</p>
          <div class="meta"><a class="meta-link" href="https://aiinasia.com" target="_blank" rel="noopener noreferrer">aiinasia.com</a></div>
        </article>

        <article class="case">
          <div class="tag">Advisory, since 2020</div>
          <h3>BlackStorm Group.</h3>
          <p>Advisor on growth, transformation, and AI adoption for BlackStorm's Asia-Pacific portfolio of founders and scale-ups. Workshops, board prep, and the harder conversations about which AI initiatives to stop.</p>
          <div class="meta"><a class="meta-link" href="https://blackstormco.asia" target="_blank" rel="noopener noreferrer">blackstormco.asia</a></div>
        </article>

      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="section-head">
        <h2>How I operate.</h2>
        <p class="aside">Four things that show up in most of the work, whatever the room is.</p>
      </div>
      <div class="help">
        <div class="help-card">
          <h4>One</h4>
          <h3>Strategy to execution.</h3>
          <p>I do not stop at the slide deck. I have sourced deals, integrated teams, and shipped products, then owned the P&amp;L that followed.</p>
        </div>
        <div class="help-card">
          <h4>Two</h4>
          <h3>Cross-functional leadership.</h3>
          <p>Product, commercial, and governance under one roof. I build teams that ship without a translator sitting between strategy and delivery.</p>
        </div>
        <div class="help-card">
          <h4>Three</h4>
          <h3>AI-native operating.</h3>
          <p>Twenty-five years turning AI and data capability into something a board can actually read, not a slide that collapses under one question.</p>
        </div>
        <div class="help-card">
          <h4>Four</h4>
          <h3>Board and advisory work.</h3>
          <p>Non-executive and start up advisory roles that complement the day job, not compete with it. A handful of relationships a year, geography-open, selected in both directions.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="edge" class="dark">
    <div class="container">
      <div class="section-head">
        <h2 style="color:#F4ECD8">The EDGE Framework.</h2>
        <p class="aside" style="color:#B7A98E">A practical structure for applied intelligence. Four pillars. Used by founders, operators, and boards.</p>
      </div>

      <p class="edge-quote">Artificial intelligence is widely accessible.<br /><em>Structured capability is not.</em></p>

      <div class="pillars">
        <div class="pillar">
          <div class="num">01</div>
          <h3>Evaluate.</h3>
          <p>Where you actually are. Capability, exposure, and the gap between what your AI tools do and what your teams say they do.</p>
        </div>
        <div class="pillar">
          <div class="num">02</div>
          <h3>Define.</h3>
          <p>What "good" looks like for your organisation. The specific outcomes AI is allowed to chase, and the ones it is not.</p>
        </div>
        <div class="pillar">
          <div class="num">03</div>
          <h3>Govern.</h3>
          <p>The decisions, controls, and review cadence that turn AI activity into AI capability. Board-legible. Not theatre.</p>
        </div>
        <div class="pillar">
          <div class="num">04</div>
          <h3>Elevate.</h3>
          <p>What changes about your people, your operating model, and your competitive position when the first three are in place.</p>
        </div>
      </div>

      <div class="ctarow" style="margin-top:48px">
        <a class="btn btn-primary" href="/documents/EDGE-Framework-Whitepaper.pdf" target="_blank" rel="noopener noreferrer" style="background:#D89A55;color:#1A1714">Download the EDGE white paper</a>
        <a class="btn btn-secondary" href="/edge" style="border-color:#E9E2D2;color:#E9E2D2">Try the EDGE Diagnostic</a>
      </div>
      <p style="font-size:13px;color:#F4ECD8;opacity:0.92;margin-top:18px;max-width:none">Tools and diagnostic live on <a href="https://democratising.ai" target="_blank" rel="noopener noreferrer">democratising.ai</a>. Built on the EDGE Framework.</p>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="now-grid">
        <div class="label">
          <h2><a href="/now" class="now-heading-link">/now.</a></h2>
          <p>What I am working on this quarter. Updated monthly. Borrowed from Derek Sivers.</p>
        </div>
        <div class="body">
          {digestParagraphs.map((p) => (<p>{p}</p>))}
          <p class="now-cta"><a href="/now" class="now-cta-link">Read the full /now log →</a></p>
        </div>
      </div>
    </div>
  </section>

  <section id="writing" class="alt">
    <div class="container">
      <div class="section-head">
        <h2>More of me.</h2>
        <p class="aside">Five places to go deeper.</p>
      </div>
      <div class="slots">

        <article class="slot">
          <div class="kicker">Weekly</div>
          <h3>Friday Frame.</h3>
          <p>A 200-500 word frame on what I noticed this week. Operators, governance, Asia, Europe, and the US. Cross-posted to LinkedIn, archived here.</p>
          <a class="more" href="/writing/friday-frame">Read the archive</a>
        </article>

        <article class="slot">
          <div class="kicker">Quarterly</div>
          <h3>Reading list.</h3>
          <p>Five books a quarter, one line each. The Patrick Collison move. {currentCardLine()}</p>
          <a class="more" href="/now#reading">Read the list</a>
        </article>

        <article class="slot">
          <div class="kicker">Long-form</div>
          <h3>Essays and cross-posts.</h3>
          <p>The canonical executive writing. LinkedIn Pulse essays archived here, plus <a href="https://aiinasia.com" target="_blank" rel="noopener noreferrer">AIinASIA</a> cross-posts that earn a longer read.</p>
          <a class="more" href="/writing">Read the essays</a>
        </article>

        <article class="slot">
          <div class="kicker">This quarter</div>
          <h3>/now.</h3>
          <p>What I am working on this quarter. Updated monthly. Borrowed from Derek Sivers and the <a href="https://nownownow.com/about" target="_blank" rel="noopener noreferrer">nownownow.com</a> convention.</p>
          <a class="more" href="/now">See what is current</a>
        </article>

        <article class="slot">
          <div class="kicker">Stage and panel</div>
          <h3>/speaking.</h3>
          <p>Recent and upcoming keynotes, panels, and moderation. Selected engagements across Asia-Pacific and beyond.</p>
          <a class="more" href="/speaking">See the calendar</a>
        </article>

      </div>
    </div>
  </section>

  <section id="feature" class="alt">
    <div class="container">
      <div class="section-head">
        <h2>Recent feature.</h2>
        <p class="aside">A longer conversation on the craft behind the work.</p>
      </div>
      <article class="case">
        <div style="display:flex;align-items:flex-start;gap:14px;margin-bottom:14px">
          <img src="/images/logos/ortus-club.png" alt="Ortus Club logo" width="44" height="44" style="flex:0 0 44px;width:44px;height:44px;border-radius:6px;background:#000;display:block" />
          <div class="tag" style="margin:0">Interview, Ortus Club</div>
        </div>
        <h3><a href="https://www.ortusclub.com/moderator/why-is-democratising-the-room-the-most-underrated-skill-in-executive-moderation-adrian-watkins-sqreem-technologies/" target="_blank" rel="noopener noreferrer">Why is democratising the room the most underrated skill in executive moderation?</a></h3>
        <p>Ortus Club sat down with Adrian on the craft of executive moderation: preparation, reading the room, and giving the quietest person at the table a way in.</p>
        <blockquote style="margin:18px 0;padding-left:26px;border-left:3px solid #D89A55;font-style:italic">"My job is not to be the smartest person in the room. It is to make sure the table's intelligence is evenly distributed, and that everybody who wants to have a say has a say."</blockquote>
        <div class="meta"><a class="meta-link" href="https://www.ortusclub.com/moderator/why-is-democratising-the-room-the-most-underrated-skill-in-executive-moderation-adrian-watkins-sqreem-technologies/" target="_blank" rel="noopener noreferrer">Read the interview on Ortus Club</a></div>
      </article>
    </div>
  </section>

  <section id="speaking">
    <div class="container">
      <div class="section-head">
        <h2>Upcoming and recent.</h2>
        <p class="aside">Selected engagements. Full calendar on the speaking page.</p>
      </div>

      <PhotoSlot
        src="speaking-government.jpg"
        alt="Adrian Watkins on stage opening the Taipei City Government Smart Living, Sustainable Future 2025 event."
        description="Adrian opening the Taipei City Government keynote at Smart Living, Sustainable Future 2025."
        aspectRatio="16 / 9"
        caption="Opening keynote, Smart Living, Sustainable Future 2025. Taipei City Government, November 2025."
      />

      <div class="eyebrow" style="margin-bottom:18px">Upcoming and ongoing</div>
      <div class="speak">
        {homeUpcoming.map((entry) => (
          <div class="speak-card">
            <div class="when">{entry.homepage.when ?? entry.when}</div>
            <h3 set:html={entry.homepage.titleHtml} />
            <p set:html={entry.homepage.bodyHtml} />
          </div>
        ))}
      </div>

      <div class="eyebrow" style="margin:40px 0 18px 0">Recent</div>
      <div class="speak">
        {homeRecent.map((entry) => (
          <div class="speak-card">
            <div class="when">{entry.homepage.when ?? entry.when}</div>
            <h3 set:html={entry.homepage.titleHtml} />
            <p set:html={entry.homepage.bodyHtml} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="cta alt" id="contact">
    <div class="container">
      <h2>Let's talk.</h2>
      <p class="lede">Whether it is product, AI, or where this all goes next, I would rather have a real conversation than a cold pitch.</p>
      <div class="ctarow">
        <a class="btn btn-primary" href="/contact">Get in touch</a>
        <a class="btn btn-secondary" href="/documents/AdrianWatkins_Executive-CV.pdf?v=12" target="_blank" rel="noopener noreferrer">Download my executive CV</a>
      </div>
      <p class="quiet" style="margin-top:24px;font-size:13px">I typically respond within two business days. Singapore-based, available across Asia-Pacific time zones.</p>
    </div>
  </section>

</BaseLayout>
