---
import Recommendation from '../components/Recommendation.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import { PERSON_ID } from '../data/person';
import { getUpcomingMentoring } from '../data/singapore-mentoring';

const title = 'Adrian Watkins in Singapore | Mentoring and Community';
const description = "Adrian Watkins's work with students, founders and business leaders in Singapore, including SDG Open Hack mentoring, NLB workshops and regional programmes.";

const todayISO = new Date().toISOString().slice(0, 10);
const mentoringProgrammes = getUpcomingMentoring(todayISO);

const singaporeJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Adrian Watkins in Singapore',
  url: 'https://adrianwatkins.com/singapore',
  description,
  about: { '@id': PERSON_ID },
};

// /experience does not exist yet as a page. Pointing the secondary CTA at
// /about until it does, per Adrian's instruction, so the button has a real
// destination in the meantime.
---

<BaseLayout
  title={title}
  description={description}
  current="singapore"
  ogImage="/images/speaking-workshop-blackstorm.jpg"
  ogImageAlt="Adrian Watkins delivering the BlackStorm What is Marketing, Really? workshop for the National Library Board Launch Entrepreneurship Bootcamp."
  jsonLd={singaporeJsonLd}
>
  <section class="stub" style="padding-bottom:32px">
    <div class="container">
      <div class="eyebrow">Singapore</div>
      <h1>Singapore is home</h1>

      {/* Eyebrow and H1 sit outside the grid deliberately: the grid row itself
          starts at the lede on the left, so align-items:start lines the card
          up with the first line of "Singapore is where I live..." rather
          than with the top of the eyebrow/H1 block above it. Reuses the same
          .hero-grid the homepage hero uses for text + photo (collapses to
          one column and stacks in normal DOM order below 880px, so the card
          lands right after the intro copy on mobile rather than reordering
          above it). When there are no upcoming dates the second column
          isn't rendered at all and the grid falls back to a single column,
          so the right side never sits empty. */}
      <div class="hero-grid" style={mentoringProgrammes.length === 0 ? 'grid-template-columns:1fr' : undefined}>
        <div>
          <p class="lede">Singapore is where I live, work and build. Alongside my executive responsibilities, I contribute to programmes that help students develop their ideas, founders build stronger businesses and business leaders make sense of technology.</p>
          <div class="prose" style="margin-top:8px">
            <p>I bring the experience of working across markets and leading commercial and operating teams. In a mentoring session, that usually comes down to practical questions: who is this for, what problem does it solve, and what would you need to test next?</p>
            <p>This page brings together some of that work in Singapore, alongside the regional relationships I continue to build from here.</p>
          </div>
        </div>

        {/* .callout is the site's existing boxed/highlight treatment (same
            component the essays use for a takeaway block), but its
            background/border/padding only apply inside .prose, the
            previous markup dropped that wrapper, which is why this rendered
            as unstyled floating text instead of a card. Heading sits inside
            the box too, so the title and the lists read as one deliberate
            element instead of a loose line above a separate box.

            Two programmes, so each gets its own small accent-coloured label
            (same visual recipe as .speak-card .when: 12px, uppercase,
            letter-spaced, accent colour) above its own list, rather than
            folding the programme name into every line. Grouping comes
            straight from the data shape (an array of programmes, each with
            its own entries) rather than being hard-coded here. */}
        {mentoringProgrammes.length > 0 && (
          <div class="prose">
            <aside class="callout" style="margin:0">
              <h3 style="font-size:22px;font-weight:500;margin-bottom:16px">Next mentoring dates</h3>
              {mentoringProgrammes.map((programme, i) => (
                <div style={i < mentoringProgrammes.length - 1 ? 'margin-bottom:20px' : undefined}>
                  <div style="font-size:12px;letter-spacing:0.14em;text-transform:uppercase;color:var(--accent);font-weight:600;margin-bottom:10px">{programme.label}</div>
                  <ul style="margin:0;padding:0;list-style:none;display:grid;gap:12px;font-family:'Fraunces',serif;font-size:19px;line-height:1.4;color:var(--ink)">
                    {programme.entries.map((entry) => (
                      <li>{entry.detail}</li>
                    ))}
                  </ul>
                </div>
              ))}
            </aside>
          </div>
        )}
      </div>

      {/* CTA row moved below both columns rather than kept in the narrower
          left column. These are page-level actions relevant to the whole
          hero (intro and the mentoring card both), not specifically tied to
          the first paragraph, so a full-width row after both columns is a
          reasonable place for them, not just a fallback. It also matches
          /contact's own hero CTA row exactly: plain .ctarow/.btn, no
          per-button overrides, at the full unconstrained container width,
          rather than fighting the left column's fixed 1.55fr share, which
          is what was forcing "Discuss a mentoring or guest session" to wrap
          and the two buttons to sit at different heights. */}
      <div class="ctarow" style="margin-top:28px">
        <a class="btn btn-primary" href="/contact">Discuss a mentoring or guest session</a>
        <a class="btn btn-secondary" href="/about">Explore my executive experience</a>
      </div>
    </div>
  </section>

  <section style="padding:0 0 48px 0">
    <div class="container">
      <PhotoSlot
        src="speaking-workshop-blackstorm.jpg"
        alt="Adrian Watkins delivering the BlackStorm What is Marketing, Really? workshop. Adrian at a flipchart with the workshop title on screen."
        description="Mid-flow on the National Library Board Launch Entrepreneurship Bootcamp workshop with BlackStorm Group."
        aspectRatio="4 / 3"
        caption="National Library Board and BlackStorm Group, Launch Entrepreneurship Bootcamp."
      />
    </div>
  </section>

  <section class="alt" style="padding:64px 0">
    <div class="container">
      <h2 style="margin-bottom:24px">Helping students turn ideas into practical solutions</h2>
      <div class="prose" style="margin-bottom:32px">
        <p>In 2026, I have been volunteering as a mentor with the Global Green Economic Foundation's SDG Open Hack programme in Singapore. Students work on challenges connected to the UN Sustainable Development Goals, developing solutions and learning how to explain their value.</p>
        <p>My contribution is to question assumptions, give constructive feedback and help teams connect an ambitious idea with a credible next step. I particularly enjoy the point where a team moves from describing a product to understanding the people who might use it.</p>
      </div>

      <div class="reflection-grid">
        <article class="reflection">
          <h3>Giving students space to test their thinking.</h3>
          <p class="reflection-label">SDG Open Hack, Ngee Ann Polytechnic · May 2026</p>
          <div class="prose">
            <p>On 21 May, I volunteered as a mentor for the Ngee Ann Polytechnic edition of SDG Open Hack, supporting students developing ideas connected to the UN Sustainable Development Goals.</p>
            <p>My contribution draws on the questions I use when building products and businesses: who would use this, what would make it useful to them, and what evidence would help us decide what to do next?</p>
            <p>The responsible consumption and production theme offered a way to connect commercial thinking with everyday choices and behaviour.</p>
            <p>For me, mentoring means helping students examine their own reasoning and find a practical next step. I want them to leave with greater confidence in how to develop an idea, including the confidence to change it when they learn something new.</p>
          </div>
        </article>

        <article class="reflection">
          <h3>Connecting sustainability with everyday use.</h3>
          <p class="reflection-label">SDG Open Hack, Nanyang Technological University · September 2026</p>
          <div class="prose">
            <p>I continued my involvement with SDG Open Hack through the NTU edition, joining an online mentoring session on 5 September.</p>
            <p>The programme explored nature-positive cities and communities, alongside responsible consumption through circular retail innovation. These themes bring an important question into focus: how can a worthwhile ambition become something people can use in everyday life?</p>
            <p>My role was to help students question assumptions, sharpen their business pitches and connect their proposed solutions with the people they hoped to serve.</p>
            <p>I value the opportunity to contribute experience while giving students room to develop their own approach. Supporting that process is a meaningful part of how I contribute to Singapore’s next generation of builders and business leaders.</p>
          </div>
        </article>
</div>
    </div>
  </section>

  <section style="padding:64px 0">
    <div class="container">
      <h2 style="margin-bottom:24px">Working with Singapore founders</h2>
      <div class="mentoring-recommendation"><Recommendation quote="Often voted as 'most requested mentor' Adrian has a natural talent for bringing people together and motivating them to achieve their best." name="Selma Ayuanshari" relationship="Mentoring programme collaborator" date="3 July 2023" datetime="2023-07-03" /></div>


        <article class="reflection">
          <h3>Helping an idea become a business.</h3>
          <p class="reflection-label">National Library Board and BlackStorm Group · March 2026</p>
          <div class="prose">
            <p>I returned to the Launch Entrepreneurship Bootcamp for a second year, facilitating the Business Model Canvas and Marketing module on 1 March.</p>
            <p>The session connected the ambition behind a business idea with the choices needed to make it work: who it serves, what value it offers, and how to reach the people who might become customers.</p>
            <p>I enjoy bringing an operating perspective into these conversations. A promising idea becomes more useful when its founder can explain the audience, recognise the assumptions they are making and decide what to test first.</p>
            <p>I also joined Entrepreneurship Connect at the National Library the following week. Contributing to these programmes is one way I share what I have learned while staying connected to the ideas and ambitions emerging from Singapore’s founder community.</p>
          </div>
        </article>
<div class="prose previous-contribution"><p>In March 2025, I led an afternoon session on marketing, audience engagement and using AI in execution. We worked through practical exercises in communicating an idea clearly and testing whether a message earns attention.</p></div><div style="margin-top:40px">
        <article class="reflection">
          <h3>Extending my contribution across Southeast Asia.</h3>
          <p class="reflection-label">ASEAN Foundation, ASEAN SOAR Together · New appointment, September 2026</p>
          <div class="prose">
            <p>I have been selected as a mentor for the ASEAN Foundation’s ASEAN SOAR Together 2026 Group Mentorship Programme, with onboarding beginning in September.</p>
            <p>The appointment offers a further opportunity to support enterprises across Southeast Asia with practical commercial and operating experience.</p>
            <p>I look forward to helping participants work through their priorities, test their assumptions and identify useful next steps, while learning from the different markets and communities they serve.</p>
          </div>
        </article>
</div>
    </div>
  </section>

  <section class="alt" style="padding:64px 0">
    <div class="container">
      <h2 style="margin-bottom:24px">Bringing business leaders into useful conversation</h2>

      <h3>Executive moderation</h3>
      <p class="quiet" style="font-size:13px;margin-bottom:10px">The Ortus Club, May 2026</p>
      <div class="prose" style="margin-bottom:32px">
        <p>On 15 May 2026, I moderated The Era of Services Delivery, a Singapore executive roundtable organised by The Ortus Club with Rocketlane.</p>
        <p>The discussion explored services delivery and the impact of AI. My role was to guide the conversation, make space for different experiences and help participants examine the operating questions behind the technology. The discussion was held in confidence; the substance shared by participants stays in the room.</p>
      </div>

      <div class="hero-grid" style="margin-bottom:40px">
        <div>
          <h3>Making room for better conversations.</h3>
          <div class="prose">
            <p>Moderating executive discussions in Singapore is one way I contribute to the business community. It brings people with different responsibilities and experiences together to explore decisions they are working through.</p>
            <p>In my interview with The Ortus Club, I reflected on what makes those conversations useful. Preparation matters, but so does noticing whose experience could move the discussion forward, who has not yet contributed, and when a different question would help.</p>
            <p>Having participated as a sponsor, guest and moderator, I understand the value of creating space for an honest exchange. The aim is for people to leave with a perspective they can use.</p>
            <p>I bring that same approach to mentoring founders and students: ask thoughtful questions, listen carefully and help people turn what they know into a practical next step.</p>
            <p><a href="https://www.ortusclub.com/moderator/why-is-democratising-the-room-the-most-underrated-skill-in-executive-moderation-adrian-watkins-sqreem-technologies/" target="_blank" rel="noopener noreferrer">Read my interview with The Ortus Club ↗</a></p>
          </div>
        </div>
        <PhotoSlot
          src="about-ortus-roundtable-moderating.jpg"
          alt="Adrian Watkins moderating an Ortus Club executive roundtable in Singapore."
          aspectRatio="3 / 2"
          caption="Exchanging perspectives at an Ortus Club executive roundtable. Singapore."
        />
      </div>

<div class="reflection-grid">
        <article class="reflection">
          <h3>Building growth the whole business can support.</h3>
          <p class="reflection-label">Building Sustainable Sales Engines for SMEs · August 2026</p>
          <div class="prose">
            <p>On 5 August, I joined a panel exploring sales frameworks, hiring and the organisational foundations needed to support growth.</p>
            <p>It is a subject closely connected to my executive experience. Sales performance depends on how well the wider business works together, from the clarity of the offer and the way it is priced to the team’s ability to deliver what has been promised.</p>
            <p>My perspective is that sustainable growth needs alignment across those decisions. Incentives, responsibilities and customer expectations should reinforce one another.</p>
            <p>Conversations with SME leaders are an opportunity to explore how these principles can be applied at different stages of a business, with an approach suited to the team and resources available.</p>
          </div>
        </article>

        <article class="reflection">
          <h3>Keeping human judgement at the centre.</h3>
          <p class="reflection-label">EntreBoss Hub, The Competitive Edge · August 2026</p>
          <div class="prose">
            <p>I joined Mark Gaynor, Paddy Tan and Victor Chan for EntreBoss Hub’s The Competitive Edge panel, moderated by Darius Chang.</p>
            <p>The discussion brought together different perspectives on strategy and executive performance, including the role of human judgement when using AI.</p>
            <p>My contribution focused on connecting technology with the decisions a business needs to make. That means being clear about the intended outcome, understanding the evidence and ensuring someone remains accountable for what happens next.</p>
            <p>This is also the thinking behind EDGE. Tools can help us explore options and improve our reasoning, while experience and judgement help us decide what deserves action.</p>
            <p><a href="https://entrebosshub.com/event/the-competitive-edge-mastering-strategy-and-executive-performance/" target="_blank" rel="noopener noreferrer">Explore The Competitive Edge panel ↗</a></p>
          </div>
        </article>
</div><div class="prose previous-contribution"><p>I also contribute to public discussions through the founder and business community. In August 2025, I joined Koo Ping Shung and Longjin Guo for Beyond the Hype, an online panel on fractional AI leadership and its practical value for executives.</p></div>
    </div>
  </section>

  <section style="padding:64px 0">
    <div class="container">
      <h2 style="margin-bottom:24px">A regional perspective from Singapore</h2>
      <div class="prose" style="margin-bottom:32px">
        <p>My work with founders and business leaders extends across the region. Those conversations give me different perspectives to bring back to my work in Singapore.</p>
      </div>

<div style="margin-bottom:40px">
        <article class="reflection">
          <h3>Helping founders prepare for growth.</h3>
          <p class="reflection-label">BEYOND4, Pahang Innovative Startup Accelerator · June 2026</p>
          <div class="prose">
            <p>Through BEYOND4, I continued supporting the Pahang Innovative Startup Accelerator in 2026, following my involvement with the previous year’s cohort.</p>
            <p>In June, I delivered a Product Development for Scaling session and an accompanying office hour, alongside individual founder mentoring during the programme.</p>
            <p>Scaling brings a different set of decisions from launching. Founders need to consider which parts of their product and operating approach can be repeated, where customers need something different, and what the team can deliver consistently.</p>
            <p>I bring experience of working through those choices across businesses and markets. These regional relationships also broaden the perspectives I bring back to my work in Singapore, particularly around adapting an approach to local customers and commercial conditions.</p>
          </div>
        </article>
<div class="prose previous-contribution"><p>In 2025, that included an eight-session mentoring engagement.</p></div></div>
      <div style="margin-bottom:32px">
        <h3>Taiwan</h3>
        <div class="prose" style="margin-bottom:24px">
          <p>In November 2025, I travelled from Singapore to Taipei for Smart Living, Sustainable Future 2025 at t.Hub, working with the Industrial Technology Research Institute and the event team.</p>
          <p>I delivered the opening keynote, Democratising Intelligence for a Sustainable Future, and moderated a startup panel with Jameson Hsu and Debbie Chien. The visit prompted further writing about AI's energy demands and the responsibilities that come with building its infrastructure. <a href="/writing/your-ai-earning-its-energy">Read my Taiwan reflection.</a></p>
        </div>
        <PhotoSlot
          src="speaking-government.jpg"
          alt="Adrian Watkins on stage opening the Taipei City Government Smart Living, Sustainable Future 2025 event."
          description="Adrian opening the Taipei City Government keynote at Smart Living, Sustainable Future 2025."
          aspectRatio="16 / 9"
          caption="Opening keynote, Smart Living, Sustainable Future 2025. Taipei City Government, November 2025."
        />
      </div>
    </div>
  </section>

  <section class="alt" style="padding:64px 0">
    <div class="container">
      <h2 style="margin-bottom:18px">Sharing what I learn</h2>
      <div class="prose">
        <p>I publish AIinASIA and write about leadership, technology and the business decisions behind AI adoption. Singapore is a recurring part of that work, from its approach to long-term planning to the way its businesses and institutions build capability. <a href="/writing">Read my writing.</a></p>
      </div>
    </div>
  </section>

  <section class="dark" style="padding:80px 0">
    <div class="container">
      <h2 style="color:#F4ECD8;margin-bottom:20px">Invite me to contribute</h2>
      <div style="color:#C4B89F;max-width:680px;font-family:'Fraunces',serif;font-size:20px;line-height:1.5">
        <p style="margin-bottom:20px">I welcome conversations with Singapore universities, polytechnics, student programmes and founder communities about mentoring, guest sessions and practical workshops.</p>
        <p style="margin-bottom:20px">Topics I can contribute to include customer discovery, commercial strategy, moving from an idea to an operating plan, and making informed decisions about AI. I am happy to discuss pro bono student sessions where the topic, audience and timing fit.</p>
        <p style="margin-bottom:32px">Tell me about your programme, who will be in the room and what you would like them to take away.</p>
      </div>
      <div class="ctarow">
        <a class="btn btn-primary" href="/contact" style="background:#D89A55;flex:0 0 auto">Discuss a session</a>
        <a class="btn btn-secondary" href="mailto:me@adrianwatkins.com" style="border-color:#E9E2D2;color:#E9E2D2;flex:0 0 auto;min-width:auto">me@adrianwatkins.com</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .mentoring-recommendation { max-width: 760px; margin: 32px 0 40px; }
  .reflection-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:40px; }
  .reflection { border-top:1px solid var(--rule, #c5baa7); padding-top:22px; }
  .reflection h3 { margin-bottom:12px; }
  .reflection-label { color:var(--accent); font-size:13px; line-height:1.5; margin-bottom:20px; }
  .reflection .prose { max-width:760px; }
  .previous-contribution { margin-top:28px; font-size:14px; }
  @media(max-width:760px) { .reflection-grid { grid-template-columns:1fr; gap:32px; } }
</style>
