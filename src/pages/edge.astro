---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PERSON_ID } from '../data/person';

const title = 'EDGE Framework by Adrian Watkins | Thinking, Decisions and Execution';
const description = 'Explore EDGE by Adrian Watkins: Evaluate, Define, Govern and Elevate. A practical business framework for clearer thinking, better decisions and effective execution.';
const edgeJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'EDGE Framework by Adrian Watkins',
    url: 'https://adrianwatkins.com/edge',
    description,
    mainEntity: { '@id': 'https://adrianwatkins.com/edge#framework' },
    about: { '@id': PERSON_ID },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    '@id': 'https://adrianwatkins.com/edge#framework',
    name: 'EDGE Framework for Applied Intelligence',
    creator: { '@id': PERSON_ID },
    url: 'https://adrianwatkins.com/edge',
    description,
  },
];
const pillars = [
  { name: 'Evaluate', subtitle: 'Understand before you act.', body: 'Explore the situation, the evidence and the people involved. Draw on what you know, identify what needs checking and consider different perspectives.', ask: 'What are we trying to understand? What do we know? Which assumptions should we test?', outcome: 'A clear picture of the situation and the choices available.', forward: 'Evidence, context and insights.' },
  { name: 'Define', subtitle: 'Give the work a clear direction.', body: 'Decide what you want to achieve and why it matters. Set priorities, clarify the message and agree how you will recognise progress.', ask: 'What outcome matters most? Who needs to be involved? What would success look like?', outcome: 'A shared direction, clear ownership and a practical next step.', forward: 'A clear outcome, priorities and direction.' },
  { name: 'Govern', subtitle: 'Create the conditions for confident action.', body: 'Build accountability, decision boundaries and proportionate checks into the approach. Give people the clarity to move forward and know when to seek another perspective.', ask: 'Who can decide? What needs checking? When should we review or adapt?', outcome: 'Practical guardrails that enable progress and help anticipate issues before they become costly.', forward: 'Accountability and the conditions for confident execution.' },
  { name: 'Elevate', subtitle: 'Apply, improve and build capability.', body: 'Apply what you learn to improve the outcome and how you work. Share useful insights, develop people and carry the learning into the next decision.', ask: 'What have we learned? What should we improve? Where else could this help?', outcome: 'A stronger approach and learning you can use again.', forward: 'Applied learning, improved outcomes and stronger capability.' },
];
const tools = [
  { slug: 'decision-simulation', name: 'Decision Simulation', description: 'Explore alternative paths, assumptions and possible consequences.' },
  { slug: 'before-you-send', name: 'Before You Send', description: 'Consider how different audiences might interpret your message and refine it before sharing.' },
  { slug: 'conversation-simulator', name: 'Conversation Simulator', description: 'Rehearse an important conversation and explore different approaches.' },
  { slug: 'negotiation-simulator', name: 'Negotiation Simulator', description: 'Practise your approach and consider another party’s perspective.' },
];
---

<BaseLayout title={title} description={description} current="edge" ogImage="/images/edge-workshop.jpg" jsonLd={edgeJsonLd}>
  <section class="stub edge-hero">
    <div class="container">
      <img src="/images/edge-mark.svg" alt="EDGE Framework mark" width="120" height="120" class="edge-mark" />
      <div class="eyebrow">Created by Adrian Watkins</div>
      <h1>The EDGE Framework.</h1>
      <p class="lede">A practical framework for clearer thinking, better decisions and effective execution.</p>
      <div class="prose">
        <p>I created EDGE to help people turn knowledge, experience and insight into action. It gives structure to the work of understanding a situation, choosing a direction, acting with confidence and learning as you go.</p>
        <p>You can apply it to a single message, an important decision, a team priority or a wider business initiative. AI-powered tools help you explore and practise that thinking. Your context and judgement guide the outcome.</p>
      </div>
      <div class="ctarow">
        <a class="btn btn-primary" href="https://democratising.ai/tools" target="_blank" rel="noopener noreferrer">Explore the tools</a>
        <a class="btn btn-secondary" href="/documents/EDGE-Framework-Whitepaper.pdf" target="_blank" rel="noopener noreferrer">Read the white paper</a>
      </div>
    </div>
  </section>

  <section class="alt edge-section">
    <div class="container">
      <h2>Why I created EDGE.</h2>
      <div class="prose">
        <p>My work brings together commercial operations, people, products and governance across markets. That requires moving between the wider ambition and the decisions that make it happen.</p>
        <p>EDGE brings those perspectives together. It creates a shared structure for asking useful questions, making priorities clear and carrying learning into action.</p>
        <p>EDGE follows a deliberate sequence: Evaluate, Define, Govern and Elevate. Each stage builds on what you learned in the previous one, taking you from understanding the situation to acting, improving and developing capability.</p>
        <p>Evaluate is the recommended starting point when working through a decision or initiative. You can also enter at any pillar when you have a specific need, particularly when using the tools. Bring the relevant context with you and revisit earlier stages whenever new information changes your understanding.</p>
        <p>The depth should fit the task: a message may need a few thoughtful minutes; a business initiative may involve several teams.</p>
      </div>
      <nav class="edge-sequence" aria-label="EDGE pillars">
        {pillars.map((pillar, index) => (
          <a href={`#${pillar.name.toLowerCase()}`}><span class="eyebrow">0{index + 1}</span><strong>{pillar.name}</strong><span>{pillar.forward}</span></a>
        ))}
      </nav>
    </div>
  </section>

  {pillars.map((pillar, index) => (
    <section id={pillar.name.toLowerCase()} class:list={['edge-section', { alt: index % 2 === 1 }]}>
      <div class="container">
        <div class="eyebrow">Pillar 0{index + 1}</div>
        <h2>{pillar.name}.</h2>
        <h3>{pillar.subtitle}</h3>
        <div class="prose">
          <p>{pillar.body}</p>
          <p><strong>Ask:</strong> {pillar.ask}</p>
          <p><strong>Leave with:</strong> {pillar.outcome}</p>
          {pillar.name === 'Govern' && <p>Relevant responsibilities and boundaries inform every stage. Here, you formalise the arrangements around the direction you have defined.</p>}
        </div>
      </div>
    </section>
  ))}

  <section class="edge-section">
    <div class="container">
      <h2>What this looks like in practice.</h2>
      <div class="prose">
        <p><strong>Illustration: preparing a message about a change in direction.</strong></p>
        <p>Start by considering the context and how different audiences might interpret the message. Define what people need to understand and what you want them to do next. Check accuracy, confidentiality and who should review it. Then refine the message and learn from the response.</p>
        <p>The same four questions scale to larger work, from aligning teams after an acquisition to preparing a product launch or entering a new market.</p>
      </div>
    </div>
  </section>

  <section class="alt edge-section">
    <div class="container">
      <h2>Practical tools. Human judgement.</h2>
      <div class="prose">
        <p>I have created AI-powered tools on <a href="https://democratising.ai/tools" target="_blank" rel="noopener noreferrer">democratising.ai</a> to help people apply EDGE to specific business situations.</p>
      </div>
      <div class="edge-tool-grid">
        {tools.map(tool => (
          <article class="edge-tool">
            <h3><a href={`https://democratising.ai/tools/${tool.slug}`} target="_blank" rel="noopener noreferrer">{tool.name}</a></h3>
            <p>{tool.description}</p>
          </article>
        ))}
      </div>
      <div class="prose">
        <p>The wider collection includes tools for brand definition, ethical trade-offs, governance review and planning.</p>
        <p>Use them to broaden your thinking, prepare and reflect. Their outputs are material to consider as you apply your own experience, knowledge and judgement.</p>
      </div>
      <a class="btn btn-primary" href="https://democratising.ai/tools" target="_blank" rel="noopener noreferrer">Explore all EDGE tools</a>
    </div>
  </section>

  <section class="edge-section">
    <div class="container">
      <h2>Built from Singapore, applicable across markets.</h2>
      <div class="prose">
        <p><a href="/singapore">Singapore is home</a> and the base for my work across regions. That experience shapes how I think about applying a common framework in different settings.</p>
        <p>The questions can remain consistent while the answers reflect local commercial conditions, regulations, working cultures and expectations. Understanding that context is part of using EDGE well.</p>
      </div>
    </div>
  </section>

  <section class="dark edge-section edge-cta">
    <div class="container">
      <h2>Put EDGE to work.</h2>
      <p>Explore the tools, read the framework or get in touch to discuss how EDGE could support a team session, workshop or business initiative.</p>
      <div class="ctarow">
        <a class="btn btn-primary" href="https://democratising.ai/tools" target="_blank" rel="noopener noreferrer">Explore the EDGE tools</a>
        <a class="btn btn-secondary" href="/documents/EDGE-Framework-Whitepaper.pdf" target="_blank" rel="noopener noreferrer">Read the white paper</a>
        <a class="btn btn-secondary" href="/contact">Discuss EDGE with me</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .edge-hero { padding-bottom: 48px; }
  .edge-mark { display: block; width: 120px; height: 120px; margin-bottom: 24px; }
  .edge-section { padding: 64px 0; scroll-margin-top: 80px; }
  .prose { margin-top: 24px; }
  .edge-sequence { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 36px; }
  .edge-sequence a { display: flex; flex-direction: column; gap: 10px; padding: 22px; border: 1px solid var(--rule); text-decoration: none; }
  .edge-sequence a:hover { border-color: var(--accent); }
  .edge-sequence strong { font-family: 'Fraunces', serif; font-size: 23px; }
  .edge-sequence span:last-child { font-size: 15px; line-height: 1.5; color: var(--ink-soft); }
  .edge-tool-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; margin: 32px 0; }
  .edge-tool { border: 1px solid var(--rule); padding: 28px; }
  .edge-tool h3 { font-size: 24px; }
  .edge-tool p { margin-bottom: 0; }
  .edge-cta h2, .edge-cta p { color: #F4ECD8; }
  .edge-cta .btn-primary { background: #D89A55; color: #1A1714; }
  .edge-cta .btn-secondary { border-color: #E9E2D2; color: #E9E2D2; }
  @media (max-width: 880px) { .edge-sequence { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) {
    .edge-sequence, .edge-tool-grid { grid-template-columns: 1fr; }
    .edge-section { padding: 44px 0; }
  }
</style>
