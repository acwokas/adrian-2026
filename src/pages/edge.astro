---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoSlot from '../components/PhotoSlot.astro';

const title = 'EDGE Framework. Adrian Watkins.';
const description = 'A practical framework for applied intelligence. Four pillars: Evaluate, Define, Govern, Elevate. Used by founders, operators, and boards across Asia-Pacific.';
---

<BaseLayout title={title} description={description} current="edge">
  <section class="stub">
    <div class="container">
      <div class="eyebrow">EDGE Framework</div>
      <h1>A practical framework for applied intelligence.</h1>
      <p class="lede">Artificial intelligence is widely accessible. Structured capability is not. EDGE is the answer I built for the teams I work with, and the working language I give boards for AI capability that does not collapse the first time someone asks what it actually did.</p>

      <PhotoSlot
        src="edge-workshop.jpg"
        alt="Adrian Watkins running an EDGE workshop. Whiteboard, sticky notes, small group."
        description="Adrian in a workshop session. Whiteboard, sticky notes, small group."
        meta="Drop the JPG at /public/images/edge-workshop.jpg to populate."
        aspectRatio="16 / 9"
      />

      <p class="prose">The four pillars (Evaluate, Define, Govern, Elevate) get their own deep-dive pages in Phase 2, with the long-form copy, the canonical EDGE diagram, the 19-page white paper, and the EDGE Diagnostic teaser linking through to democratising.ai. The Phase 1 home page summarises the pillars; this page is the canonical landing for the framework.</p>

      <p class="stub-note">Four pillar pages, the canonical EDGE diagram (SVG), the white paper, and the EDGE Diagnostic teaser ship in Phase 2. The tools and diagnostic itself live on democratising.ai.</p>
      <!-- TODO: phase 2 - four pillar deep-dive pages (/edge/evaluate, /edge/define, /edge/govern, /edge/elevate), canonical SVG diagram, 19-page white paper download, EDGE Diagnostic teaser, "without X..." sections with five-question lists, cross-link to democratising.ai -->
    </div>
  </section>
</BaseLayout>
