# Cloudflare Pages custom response headers.
# https://developers.cloudflare.com/pages/configuration/headers/
# Auto-deploy verification: 2026-05-20 (first GH Actions run confirmed)

# CV PDF: revalidate aggressively so a fresh upload is visible without users
# needing to hard-refresh. ETag still does the heavy lifting; this just
# ensures the browser checks back every 5 minutes instead of every 4 hours.
/documents/AdrianWatkins_Executive-CV.pdf
  Cache-Control: public, max-age=300, must-revalidate

# Wildcard match for the same path as a belt-and-braces (CF Pages applies the
# most specific rule but list both forms in case of order quirks).
/documents/*.pdf
  Cache-Control: public, max-age=300, must-revalidate
